+        t_tok += now() - t0, tok_run += R;
+        // (2) each row alone through the rows path
+        hist_io(sq, false);
+        one.clear();
+        for (int r = 0; r < R; ++r) {
+            fast_rows(M, &tk[r], &sq[r], &ps[r], 1, OutMode::kLogits, one, nullptr);
+            maps[1].insert({sq[r]}), ++replays[1];
+        }
+        // (3) all together
+        hist_io(sq, false);
+        all.clear();
+        t0 = now();
+        fast_rows(M, tk.data(), sq.data(), ps.data(), R, OutMode::kLogits, all, nullptr);
+        t_rows += now() - t0, ++rows_run, rows_rows += R;
+        maps[R].insert(sq), ++replays[R];
+        // (4) all again, row i of this run row (i + 1) % R of the last
+        std::vector<int> sq2(R), tk2(R), ps2(R);
+        for (int i = 0; i < R; ++i) sq2[i] = sq[(i + 1) % R], tk2[i] = tk[(i + 1) % R], ps2[i] = ps[(i + 1) % R];
+        hist_io(sq, false);
+        all2.clear();
+        fast_rows(M, tk2.data(), sq2.data(), ps2.data(), R, OutMode::kLogits, all2, nullptr);
+        maps[R].insert(sq2), ++replays[R];
+        int n_alone = 0, n_reord = 0, n_top = 0;
+        double kl_max = 0;
+        for (int r = 0; r < R; ++r) {
+            const std::string at = "step " + std::to_string(k) + ", slot " + std::to_string(sq[r]) + " at " +
+                                   std::to_string(ps[r]);
+            const float* a = all.data() + (size_t) r * V;
+            n_alone += same(one.data() + (size_t) r * V, a, at + ": alone against together");
+            n_reord += same(all2.data() + (size_t) ((r + R - 1) % R) * V, a, at + ": reordered against together");
+            const double d = kl(ref.data() + (size_t) r * V, a);
+            kl_tok[sq[r]].push_back(d), kl_max = std::max(kl_max, d);
+            const bool t1 = argmax(ref.data() + (size_t) r * V) == argmax(a);
+            top_tok[sq[r]] += t1, n_top += t1;
+        }
+        // (5) every third step: the kArgmax and kCand graphs against the logits (the same rows, the map reversed)
+        if (k % 3 == 2) {
+            std::vector<int> sq3(sq.rbegin(), sq.rend()), tk3(tk.rbegin(), tk.rend()), ps3(ps.rbegin(), ps.rend());
+            std::vector<int> am;
+            std::vector<float> none;
+            hist_io(sq, false);
+            fast_rows(M, tk3.data(), sq3.data(), ps3.data(), R, OutMode::kArgmax, none, &am);
+            maps[R].insert(sq3), ++replays[R];
+            for (int i = 0; i < R; ++i) {
+                const float* a = all.data() + (size_t) (R - 1 - i) * V;
+                ++n_cmp;
+                if (am[i] < 0 || am[i] >= V || a[am[i]] != a[argmax(a)]) {
+                    ++n_bad;
+                    std::printf("rows check: MISMATCH step %d, slot %d: kArgmax gave %d, not a top logit\n", k, sq3[i],
+                                am[i]);
+                }
+            }
+            hist_io(sq, false);
+            fast_rows(M, tk.data(), sq.data(), ps.data(), R, OutMode::kCand, none, nullptr);
+            for (int r = 0; r < R; ++r) {
+                const float* a = all.data() + (size_t) r * V;
+                std::vector<std::pair<float, int>> cd;
+                if (!block_cands(M, r, cd)) {   // (more candidates than kept: the serve loop takes the row's logits)
+                    std::printf("rows check: step %d, slot %d: more candidates than kept (not compared)\n", k, sq[r]);
+                    continue;
+                }
+                ++n_cmp;
+                bool ok = !cd.empty();
+                float best = -INFINITY;
+                for (const auto& e : cd) {
+                    ok = ok && e.second >= 0 && e.second < V && !std::memcmp(&e.first, a + e.second, 4);
+                    best = std::max(best, e.first);
+                }
+                ok = ok && best == a[argmax(a)];
+                if (!ok) {
+                    ++n_bad;
+                    std::printf("rows check: MISMATCH step %d, slot %d: kCand's candidates are not the logits' top\n",
+                                k, sq[r]);
+                }
+            }
+        }
+        // the twins: the same tokens on the token path, each on its own state all along
+        double kl_tw = 0;
+        int n_top_tw = 0;
+        if (twins) {
+            twin.clear();
+            for (int r = 0; r < R; ++r) {
+                const int z = sq[r] + NR;
+                if (sh[z].pos != ps[r]) die("--rows-check: a twin's position");
+                decode_rows(M, &tk[r], &z, &sh[z].pos, 1, OutMode::kLogits, twin, nullptr);
+                ++sh[z].pos;
+            }
+            for (int r = 0; r < R; ++r) {
+                const float* a = all.data() + (size_t) r * V;
+                const float* b = twin.data() + (size_t) r * V;
+                const double d = kl(b, a);
+                kl_twin[sq[r]].push_back(d), kl_tw = std::max(kl_tw, d);
+                const bool t1 = argmax(a) == argmax(b);
+                top_twin[sq[r]] += t1, n_top_tw += t1;
+            }
+        }
+        for (int r = 0; r < R; ++r) {
+            SlotHost& h = sh[sq[r]];
+            h.hist.push_back(tk[r]);
+            h.last = argmax(all.data() + (size_t) r * V);
+            ++h.pos, ++n_in[sq[r]];
+        }
+        std::printf("rows check: step %d, %d rows (slot@pos", k, R);
+        for (int r = 0; r < R; ++r) std::printf(" %d@%d", sq[r], ps[r]);
+        std::printf("): alone %d/%d, reordered %d/%d bit for bit; the token path: KL max %.2e, top-1 %d/%d", n_alone, R,
+                    n_reord, R, kl_max, n_top, R);
+        if (twins) std::printf("; twins: KL max %.2e, top-1 %d/%d", kl_tw, n_top_tw, R);
+        std::printf("\n");
+        std::fflush(stdout);
+    }
+    CU(cudaFree(bak));
+    auto median = [](std::vector<double> v) {
+        if (v.empty()) return 0.0;
+        std::sort(v.begin(), v.end());
+        return v.size() % 2 ? v[v.size() / 2] : 0.5 * (v[v.size() / 2 - 1] + v[v.size() / 2]);
+    };
+    auto vmax = [](const std::vector<double>& v) { return v.empty() ? 0.0 : *std::max_element(v.begin(), v.end()); };
+    std::vector<double> kl_all, kl_twin_all;
+    int top_all = 0, top_twin_all = 0, in_all = 0;
+    for (int s = 0; s < NR; ++s) {
+        std::printf("rows check: slot %d: prompt %zu tokens, %d steps (positions %d .. %d); the token path at the same "
+                    "state: KL median %.2e, max %.2e, top-1 %d/%d",
+                    s, prompts[s].size(), n_in[s], pos0[s], pos0[s] + std::max(0, n_in[s] - 1), median(kl_tok[s]),
+                    vmax(kl_tok[s]), top_tok[s], n_in[s]);
+        if (twins)
+            std::printf("; its twin (the token path all along): KL median %.2e, max %.2e, top-1 %d/%d",
+                        median(kl_twin[s]), vmax(kl_twin[s]), top_twin[s], n_in[s]);
+        std::printf("\n");
+        kl_all.insert(kl_all.end(), kl_tok[s].begin(), kl_tok[s].end());
+        kl_twin_all.insert(kl_twin_all.end(), kl_twin[s].begin(), kl_twin[s].end());
+        top_all += top_tok[s], top_twin_all += top_twin[s], in_all += n_in[s];
+    }
+    std::printf("rows check: all rows: the token path at the same state: KL median %.2e, max %.2e, top-1 %.2f%%",
+                median(kl_all), vmax(kl_all), 100.0 * top_all / std::max(1, in_all));
+    if (twins)
+        std::printf("; twins: KL median %.2e, max %.2e, top-1 %.2f%%", median(kl_twin_all), vmax(kl_twin_all),
+                    100.0 * top_twin_all / std::max(1, in_all));
+    std::printf(" (scope's target with F16 KV: median <= 1e-4, top-1 >= 98%%)\n");
+    long n_maps = 0, n_replays = 0;
+    bool maps_ok = true;
+    for (const auto& e : maps) {
+        n_maps += (long) e.second.size(), n_replays += replays[e.first];
+        std::printf("rows check: the %d-row graphs: %ld replays, %zu distinct rows-to-slots maps\n", e.first,
+                    replays[e.first], e.second.size());
+        if (e.first >= 2 && e.second.size() < 2) maps_ok = false;
+    }
+    const uint64_t late = g_n_capture - cap0;
+    std::printf("rows check: %ld replays of the rows graphs with %ld maps; %llu graphs captured during the check%s\n",
+                n_replays, n_maps, (unsigned long long) late,
+                g_graph ? " (0 expected: every step replays the load's)" : " (IK2_GRAPH=0: launches one by one)");
+    std::printf("rows check: a rows step took %.2f ms for %.2f rows (%.0f tok/s); the token path %.2f ms a token "
+                "(timed between the check's own copies: not a benchmark)\n",
+                1e3 * t_rows / std::max(1L, rows_run), (double) rows_rows / std::max(1L, rows_run),
+                rows_rows / std::max(1e-9, t_rows), 1e3 * t_tok / std::max(1L, tok_run));
+    const bool pass = n_bad == 0 && (!g_graph || late == 0) && maps_ok;
+    std::printf("rows check: %s: %ld of %ld bitwise comparisons differ%s%s; KV %s, %d slots\n", pass ? "PASS" : "FAIL",
+                n_bad, n_cmp, g_graph && late ? ", graphs were captured mid-check" : "",
+                maps_ok ? "" : ", a graph never replayed with a changed slot map", g_kv_fp8 ? "FP8" : "F16", N);
+    std::fflush(stdout);
+    return pass ? 0 : 1;
+}
