+    CHECK(!c1 && h.ctl.live(1));                                       // the running request goes on
+    CHECK(h.ctl.waiting.size() == 1 && h.ctl.waiting[0].rid == 13);    // a good one after them is queued
+    ok("malformed GEN: ERR <rid> + a cancel DONE (or an untagged ERR without a rid); healthy requests go on", f0);
+}
+
+// ---- the loop itself (sv::serve_loop) over a test backend whose calls can make input lines arrive while they run:
+// a STOP arriving during a prompt piece's read, a decode step or a DONE's write must be honoured before the next
+// token, completion or admission
+
+struct TB {   // a deterministic stand-in model: a slot's state a hash of its tokens; hook(in, where, what) on each call
+    sv::Lines* in = nullptr;
+    std::function<void(sv::Lines&, const std::string&, const std::string&)> hook;
+    std::vector<std::string> out;
+    std::vector<uint64_t> state;
+    int reads = 0, steps = 0;
+    void zero(int s) { state[(size_t) s] = 1; }
+    void snap(int, int, int, bool) {}
+    bool pictures(const sv::Req&, std::vector<uint64_t>&, std::string&) { return true; }
+    void pictures_done() {}
+    void read(int s, const std::vector<int>& ids, size_t a, int T, bool last, std::vector<float>& lo) {
+        for (int t = 0; t < T; ++t) state[(size_t) s] = state[(size_t) s] * 1000003u + (uint64_t) ids[a + (size_t) t];
+        ++reads;
+        if (hook) hook(*in, "read", std::to_string(reads));   // (lines that arrive while the piece is read)
+        if (last) {
+            lo.assign((size_t) kVocab, 0.0f);
+            lo[(size_t) (1000 + state[(size_t) s] % 50000)] = 1.0f;
+        }
+    }
+    void step(const std::vector<sv::StepRow>& rows, std::vector<sv::StepOut>& o) {
+        o.assign(rows.size(), sv::StepOut{});
+        for (size_t r = 0; r < rows.size(); ++r) {
+            uint64_t& h = state[(size_t) rows[r].slot];
+            h = h * 1000003u + (uint64_t) rows[r].tok;
+            o[r].argmax = (int) (1000 + h % 50000);
+        }
+        ++steps;
+        if (hook) hook(*in, "step", std::to_string(steps));   // (... while a decode step runs)
+    }
+    bool signal() { return false; }
+    double seconds() { return 0.0; }
+    void print(const std::string& l) {
+        out.push_back(l);
+        if (hook) hook(*in, "print", l);   // (... while a line is written)
+    }
+    void flush() {}
+    void log(const std::string&) {}
+    [[noreturn]] void fatal(const std::string& m) { throw std::runtime_error(m); }
+};
+
+static std::vector<std::string> loop_run(int n_slots, const std::vector<std::string>& lines,
+                                         std::function<void(sv::Lines&, const std::string&, const std::string&)> hook) {
+    sv::Lines in;   // (no reader thread: the lines pushed here and by the hook)
+    for (const auto& l : lines) in.push(l);
+    in.end();
+    TB be;
+    be.in = &in, be.hook = std::move(hook), be.state.assign((size_t) n_slots, 1);
+    sv::LoopConfig cf;
+    cf.n_slots = n_slots, cf.vocab = kVocab, cf.ctx = kCtx, cf.chunk = 2048, cf.piece = 2048, cf.eos = {199999};
+    sv::serve_loop(be, in, cf);
+    return be.out;
+}
+static int lines_with(const std::vector<std::string>& v, const std::string& p) {
+    int n = 0;
+    for (const auto& l : v) n += l.rfind(p, 0) == 0;
+    return n;
+}
+static std::string done_of(const std::vector<std::string>& v, int rid) {
+    for (const auto& l : v)
+        if (l.rfind("DONE " + std::to_string(rid) + " ", 0) == 0) return l;
+    return "";
+}
+static std::string field(const std::string& l, int k) {   // (the k-th field, 0-based)
+    std::istringstream is(l);
+    std::string w;
+    for (int i = 0; i <= k && (is >> w); ++i) {
+    }
+    return w;
+}
+
+static void stop_for_a_queued_request_during_the_final_piece() {
+    const int f0 = g_fail;
+    // Queued one-piece A (rid 1) and B (rid 2), both max_new 1; STOP 2 arrives while A's only piece is
+    // read.  B was never in flight: it must end cancel with no token - not emit and finish "length" before the STOP
+    bool once = false;
+    const auto out = loop_run(2, {"GEN 1 rid=1 5,6,7", "GEN 1 rid=2 8,9"},
+                              [&](sv::Lines& in, const std::string& w, const std::string& what) {
+                                  if (!once && w == "read" && what == "1") once = true, in.push("STOP 2");
+                              });
+    CHECK(lines_with(out, "T 2 ") == 0 && lines_with(out, "PP 2 ") == 0);
+    CHECK(lines_with(out, "DONE 2 ") == 1 && done_of(out, 2) == "DONE 2 0 2 0 0 cancel 0 0 0");
+    CHECK(lines_with(out, "T 1 ") == 1 && field(done_of(out, 1), 6) == "length" && field(done_of(out, 1), 2) == "1");
+    ok("STOP for queued B (max_new 1) arriving during A's only piece: B cancels with no token; A completes", f0);
+}
+
+static void stop_for_the_request_during_its_only_piece() {
+    const int f0 = g_fail;
+    // STOP 1 arrives while rid 1's only piece is read (max_new 1): no PP, no token, a cancel DONE - and its slot is left
+    // empty: rid 3, whose prompt extends rid 1's, then takes that (only) slot and reuses nothing
+    bool once = false;
+    const auto out = loop_run(1, {"GEN 1 rid=1 5,6,7"}, [&](sv::Lines& in, const std::string& w, const std::string& what) {
+        if (!once && w == "read" && what == "1") once = true, in.push("STOP 1"), in.push("GEN 4 rid=3 5,6,7,8,9");
+    });
+    CHECK(lines_with(out, "T 1 ") == 0 && lines_with(out, "PP 1 ") == 0);
+    CHECK(done_of(out, 1) == "DONE 1 0 3 0.0 0 cancel 0 0 0");
+    CHECK(field(done_of(out, 3), 6) == "length" && field(done_of(out, 3), 2) == "4" && field(done_of(out, 3), 9) == "0");
+    ok("STOP for a request during its only piece: no PP / T, cancel DONE; the extending refill on its slot reuses 0", f0);
+}
+
+static void plain_stop_during_the_final_piece() {
+    const int f0 = g_fail;
+    // a plain STOP while A's only piece is read: A (in flight) and B (queued) both came before it - both cancel with no
+    // token; C, whose line came after the STOP, completes
+    bool once = false;
+    const auto out = loop_run(2, {"GEN 1 rid=1 5,6,7", "GEN 1 rid=2 8,9"},
+                              [&](sv::Lines& in, const std::string& w, const std::string& what) {
+                                  if (!once && w == "read" && what == "1") once = true, in.push("STOP"), in.push("GEN 2 rid=3 4");
+                              });
+    CHECK(lines_with(out, "T 1 ") == 0 && lines_with(out, "T 2 ") == 0);
+    CHECK(field(done_of(out, 1), 6) == "cancel" && field(done_of(out, 2), 6) == "cancel");
+    CHECK(lines_with(out, "DONE 1 ") == 1 && lines_with(out, "DONE 2 ") == 1);
+    CHECK(lines_with(out, "T 3 ") == 2 && field(done_of(out, 3), 6) == "length");
+    ok("plain STOP during A's only piece: A and queued B cancel (no token), C after the STOP completes", f0);
+}
+
+static void stop_during_the_step_of_the_last_token() {
+    const int f0 = g_fail;
+    // rid 1, max_new 3: STOP 1 arrives during the decode step that gives its 3rd token - it must end cancel with 2
+    // tokens, not write the 3rd and end "length"
+    bool once = false;
+    const auto out = loop_run(2, {"GEN 3 rid=1 5,6,7"}, [&](sv::Lines& in, const std::string& w, const std::string& what) {
+        if (!once && w == "step" && what == "2") once = true, in.push("STOP 1");
+    });
+    CHECK(lines_with(out, "T 1 ") == 2);
+    CHECK(field(done_of(out, 1), 6) == "cancel" && field(done_of(out, 1), 2) == "2");
+    ok("STOP during the decode step of a request's last token: cancel after 2 tokens, not length after 3", f0);
+}
+
+static void stop_during_a_done_reaches_the_next_admission() {
+    const int f0 = g_fail;
+    // queued A and B (max_new 1, one slot): STOP 2 arrives while A's DONE is written - before B is admitted, so B
+    // must not start: a cancel DONE with no token
+    bool once = false;
+    const auto out = loop_run(1, {"GEN 1 rid=1 5,6,7", "GEN 1 rid=2 8,9"},
+                              [&](sv::Lines& in, const std::string& w, const std::string& what) {
+                                  if (!once && w == "print" && what.rfind("DONE 1 ", 0) == 0) once = true, in.push("STOP 2");
+                              });
+    CHECK(lines_with(out, "PP 2 ") == 0 && lines_with(out, "T 2 ") == 0);
+    CHECK(done_of(out, 2) == "DONE 2 0 2 0 0 cancel 0 0 0");
+    CHECK(field(done_of(out, 1), 6) == "length");
+    ok("STOP arriving while A's DONE is written: queued B is not admitted (cancel, no PP, no token)", f0);
+}
+
+int main() {
+    stop_cancels_earlier_live_and_queued_only();
+    gen_then_stop_while_idle();
+    stop_with_nothing_live();
+    lines_keep_their_order();
+    queued_stop_retires_at_once();
+    stale_stops_never_crowd_out_a_pending_one();
+    greedy_row_takes_the_raw_argmax_on_a_capped_tie();
+    pick_top_is_seeded_and_deterministic();
+    prompt_stopped_while_read_leaves_an_empty_slot();
+    book_plans_and_snapshots();
+    parse_gen_checks();
+    malformed_lines_are_refused_and_others_go_on();
+    stop_for_a_queued_request_during_the_final_piece();
+    stop_for_the_request_during_its_only_piece();
+    plain_stop_during_the_final_piece();
+    stop_during_the_step_of_the_last_token();
+    stop_during_a_done_reaches_the_next_admission();
+    std::printf("%s: %d cases passed, %d checks failed\n", g_fail ? "FAIL" : "all passed", g_ok, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/tests/ik2_serve_tie_test.cu b/tests/ik2_serve_tie_test.cu
new file mode 100644
index 0000000..27c36e1
--- /dev/null
+++ b/tests/ik2_serve_tie_test.cu
@@ -0,0 +1,79 @@
+// tests/ik2_serve_tie_test.cu - device regression test for tied greedy candidates: a rows step that gives candidates (kCand, a
+// sampled row in the step) runs fast_rows_launches' head sequence - argmax_rows over the raw logits, then softcap, then
+// cand_topk - so a greedy row beside a sampled one takes the raw argmax, not a pick among capped values that can tie.
+// Two rows of the real vocabulary's width: row 0 a constructed tie after the softcap (raw 360 at id 5, 390 at id 9:
+// both 30 capped, float32), row 1 a plain winner.  No model; the kernels only.
+//   nvcc -std=c++17 -arch=sm_86 tests/ik2_serve_tie_test.cu <build>/libik2_kernels.a -o ik2_serve_tie_test
+#include "../src/ik2/ik2_kernels.cuh"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace k = ik2::k;
+
+#define CU(x)                                                                                  \
+    do {                                                                                       \
+        cudaError_t e_ = (x);                                                                  \
+        if (e_ != cudaSuccess) {                                                               \
+            std::printf("CUDA %s: %s (line %d)\n", #x, cudaGetErrorString(e_), __LINE__);      \
+            std::exit(1);                                                                      \
+        }                                                                                      \
+    } while (0)
+
+int main() {
+    const int V = 200058, ld = 201024, R = 2, cand_k = 1000, cand_cap = 4096;
+    const float cap = 30.0f;
+    int fail = 0;
+    // every row's crowd spread over raw [-29, 20] (capped below 17.5), so that the top bins hold a few hundred values
+    // each and cand_topk keeps its K = 1000 and some more (as with real logits - not past its cap of 4096)
+    std::vector<float> h((size_t) R * ld, -29.0f);
+    for (int t = 0; t < R; ++t)
+        for (int v = 0; v < V; ++v)
+            h[(size_t) t * ld + v] = -29.0f + 49.0f * (float) ((v * 7919LL) % V) / (float) V;
+    h[5] = 360.0f, h[9] = 390.0f;                                                     // (row 0: raw winner 9)
+    h[(size_t) ld + 123456] = 25.0f, h[(size_t) ld + 7] = 24.0f;                      // (row 1: winner 123456)
+    float* d = nullptr;
+    int *am = nullptr, *scratch = nullptr, *cand = nullptr;
+    CU(cudaMalloc(&d, h.size() * 4));
+    CU(cudaMalloc(&am, R * 4));
+    CU(cudaMalloc(&scratch, k::cand_scratch(V) * 4));
+    CU(cudaMalloc(&cand, (size_t) R * (2 + 2 * cand_cap) * 4));
+    CU(cudaMemcpy(d, h.data(), h.size() * 4, cudaMemcpyHostToDevice));
+    // fast_rows_launches' head, kCand: the raw argmax first, then the softcap and each row's candidates
+    k::argmax_rows(d, ld, R, V, am, 0);
+    k::softcap(d, (size_t) R * ld, cap, 0);
+    for (int t = 0; t < R; ++t)
+        k::cand_topk(d + (size_t) t * ld, V, -cap, cap, cand_k, cand_cap, scratch, cand + t * (2 + 2 * cand_cap), 0);
+    CU(cudaDeviceSynchronize());
+    int amh[R];
+    std::vector<int> ch((size_t) R * (2 + 2 * cand_cap));
+    std::vector<float> capped(h.size());
+    CU(cudaMemcpy(amh, am, R * 4, cudaMemcpyDeviceToHost));
+    CU(cudaMemcpy(ch.data(), cand, ch.size() * 4, cudaMemcpyDeviceToHost));
+    CU(cudaMemcpy(capped.data(), d, capped.size() * 4, cudaMemcpyDeviceToHost));
+    auto expect = [&](bool c, const char* what) {
+        std::printf("%s %s\n", c ? "ok  " : "FAIL", what);
+        fail += !c;
+    };
+    expect(amh[0] == 9, "row 0: argmax_rows over the raw logits gives 9 (raw 390 > 360)");
+    expect(amh[1] == 123456, "row 1: argmax_rows gives the plain winner 123456");
+    expect(capped[5] == capped[9] && capped[9] == cap, "row 0: the softcap makes ids 5 and 9 both 30 (a tie)");
+    // row 0's candidates: both tied ids are there at the same capped value; the lowest-id rule on them picks 5
+    const int* c0 = ch.data();
+    const int n0 = c0[0];
+    const int* idx = c0 + 2;
+    const float* val = (const float*) (c0 + 2 + cand_cap);
+    int best = -1;
+    bool has5 = false, has9 = false;
+    for (int i = 0; i < std::min(n0, cand_cap); ++i) {
+        has5 = has5 || idx[i] == 5, has9 = has9 || idx[i] == 9;
+        if (best < 0 || val[i] > val[best] || (val[i] == val[best] && idx[i] < idx[best])) best = i;
+    }
+    expect(n0 > 0 && n0 <= cand_cap && has5 && has9, "row 0: cand_topk keeps both tied ids among its candidates");
+    expect(best >= 0 && idx[best] == 5, "row 0: the capped candidates' lowest-id rule gives 5");
+    std::printf("%s: a greedy row in a mixed step takes the raw argmax (9), not the capped tie's lowest id (5)\n",
+                fail ? "FAIL" : "all passed");
+    return fail ? 1 : 0;
+}
