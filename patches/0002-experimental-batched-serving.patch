+// ---- 4. a prompt stopped while read leaves its slot empty
+
+static void prompt_stopped_while_read_leaves_an_empty_slot() {
+    const int f0 = g_fail;
+    const std::vector<int> A = seq_ids(1000, 600), other = seq_ids(9000, 50);
+    std::vector<int> D = A;   // (D extends A: 600 + 5000 tokens)
+    for (int i = 0; i < 5000; ++i) D.push_back(20000 + i);
+    const std::vector<uint64_t> sA(A.size(), 0), sD(D.size(), 0), sO(other.size(), 0);
+    sv::Book bk(2, 8);
+    // slot 0 reads A in full, a snapshot at its end, then decodes a little
+    sv::Book::Plan p = bk.plan(A, sA);
+    CHECK(p.slot == 0 && p.from == 0);
+    CHECK(bk.take(p) == sv::Book::Act::kKeep);
+    bk.read(0, 0, A, sA, A.size());
+    bk.snapshot(0, (int) A.size());
+    for (int t = 0; t < 20; ++t) bk.ran(0, 7);
+    bk.release(0);
+    // slot 1 busy with another request all along: the refill below can only take slot 0
+    sv::Book::Plan po = bk.plan(other, sO);
+    CHECK(po.slot == 1);
+    bk.take(po);
