+static void stop_cancels_earlier_live_and_queued_only() {
+    const int f0 = g_fail;
+    Harness h;
+    h.line(gen(400, 1, {10, 11}));
+    h.line(gen(400, 2, {12}));
+    h.line(gen(200, 3, {13, 14, 15}));
+    // the loop gives 1 and 2 the two slots; 3 waits
+    sv::Req a, b;
+    CHECK(h.ctl.take(a) && a.rid == 1);
+    CHECK(h.ctl.take(b) && b.rid == 2);
+    bool c1 = false, c2 = false;
+    h.ctl.started(1, &c1), h.ctl.started(2, &c2);
+    h.line("STOP");
+    h.line(gen(64, 4, {16}));   // (after the STOP: untouched)
+    CHECK(c1 && c2);                                     // both live requests stopped
+    CHECK(h.ctl.retire() == 1);                          // the queued one retired now, slot or no slot
+    CHECK(h.out.size() == 1 && h.out[0] == "DONE 3 0 3 0 0 cancel 0 0 0");   // one cancel DONE, zero tokens
+    CHECK(h.ctl.waiting.size() == 1 && h.ctl.waiting[0].rid == 4 && !h.ctl.waiting[0].cancel);
+    // the old bug: the running requests end (nothing left running) before the queue is looked at again - the STOP's
+    // effect on what came before it does not depend on that, and the request after it stays usable
+    h.ctl.ended(1), h.ctl.ended(2);
+    CHECK(h.ctl.retire() == 0);
