+// tests/ik2_rows_test.cu - the rows path's kernels (src/ik2/ik2_kernels.cu: prep_qkv_r_*_rows, attn_rows_*,
+// conv_rows) against the token path's kernels (prep_qkv_r_*_at, attn_decode_mma_*, conv4_res of one token) run once a
+// row on a copy of the same buffers.  N = 1, 2, 3, 5 and 8 rows; N + 3 slots of different sizes and contents, the rows
+// on a shuffled subset of them; mixed depths (position 0, a few tokens, under the window, past the sliding ring so
+// that it wraps, a full layer's cache of the whole context); FP8 and FP16 caches; odd row strides (rows off the
+// vector loads' alignment) at N = 3.  Every output and every byte of every slot's cache and conv history is compared
+// with memcmp: the same bits, no tolerance.  Last, prep then attention for two decode steps, rows against tokens.
+#include "../src/ik2/ik2_kernels.cuh"
+
+#include <cuda_fp16.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace k = ik2::k;
+
+namespace {
+
+int g_fail = 0, g_cases = 0;
+std::mt19937 rng(20261122);
+
+#define CU(x)                                                                                  \
+    do {                                                                                       \
+        cudaError_t e_ = (x);                                                                  \
+        if (e_ != cudaSuccess) {                                                               \
+            std::printf("CUDA %s: %s (line %d)\n", #x, cudaGetErrorString(e_), __LINE__);      \
+            std::exit(1);                                                                      \
+        }                                                                                      \
+    } while (0)
+
+float frand(float a = 1.0f) { return std::uniform_real_distribution<float>(-a, a)(rng); }
+std::vector<float> fvec(size_t n, float a = 1.0f, float c = 0.0f) {
+    std::vector<float> v(n);
+    for (auto& x : v) x = c + frand(a);
+    return v;
+}
+uint16_t f2h_host(float f) { return (uint16_t) __half_as_ushort(__float2half_rn(f)); }
+
+// the caches' bulk contents: splitmix64 (fast), FP8 bytes of magnitude under 32 (as a clipped K times 16; no NaN),
+// FP16 values of magnitude 2^-7 .. 2
+uint64_t g_sm = 0x2026112200000000ull;
+uint64_t sm64() {
+    uint64_t z = (g_sm += 0x9E3779B97F4A7C15ull);
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+    return z ^ (z >> 31);
+}
+void fill(std::vector<uint8_t>& v) {
+    for (size_t i = 0; i < v.size(); i += 8) {
+        const uint64_t r = sm64();
+        for (size_t j = 0; j < 8 && i + j < v.size(); ++j) {
+            uint8_t b = (uint8_t) (r >> (8 * j));
+            if ((b & 0x7F) >= 0x60) b &= 0xDFu;
+            v[i + j] = b;
+        }
+    }
+}
+void fill(std::vector<uint16_t>& v) {
+    for (size_t i = 0; i < v.size(); i += 2) {
+        const uint64_t r = sm64();
+        for (size_t j = 0; j < 2 && i + j < v.size(); ++j) {
+            const uint32_t u = (uint32_t) (r >> (32 * j));
+            v[i + j] = (uint16_t) ((u & 0x83FFu) | ((8u + ((u >> 16) & 7u)) << 10));
+        }
+    }
+}
+
+template <class T>
+T* dev(const std::vector<T>& h) {
+    T* p = nullptr;
+    CU(cudaMalloc(&p, std::max<size_t>(1, h.size()) * sizeof(T)));
+    if (!h.empty()) CU(cudaMemcpy(p, h.data(), h.size() * sizeof(T), cudaMemcpyHostToDevice));
+    return p;
+}
+template <class T>
+T* dev_fill(size_t n, int byte) {   // n values, every byte `byte` (0xFF: NaN floats, a written value shows)
+    T* p = nullptr;
+    CU(cudaMalloc(&p, std::max<size_t>(1, n) * sizeof(T)));
+    CU(cudaMemset(p, byte, std::max<size_t>(1, n) * sizeof(T)));
+    return p;
+}
+template <class T>
+std::vector<T> host(const T* p, size_t n) {
+    std::vector<T> h(n);
+    CU(cudaDeviceSynchronize());
+    CU(cudaMemcpy(h.data(), p, n * sizeof(T), cudaMemcpyDeviceToHost));
+    return h;
+}
+
+// memcmp of device buffers: the first difference noted
+struct Cmp {
+    bool ok = true;
+    size_t bytes = 0;
+    std::string why;
+    template <class T>
+    void same(const std::string& what, const T* a, const T* b, size_t n) {
+        const auto ha = host(a, n), hb = host(b, n);
+        bytes += n * sizeof(T);
+        if (!std::memcmp(ha.data(), hb.data(), n * sizeof(T))) return;
+        const uint8_t *pa = (const uint8_t*) ha.data(), *pb = (const uint8_t*) hb.data();
+        size_t i = 0;
+        while (pa[i] == pb[i]) ++i;
+        if (ok) why = what + " differs at byte " + std::to_string(i) + " of " + std::to_string(n * sizeof(T));
+        ok = false;
+    }
+};
+void report(const std::string& label, const Cmp& c) {
+    ++g_cases;
+    if (!c.ok) ++g_fail;
+    std::printf("%s %s: %zu bytes%s%s\n", c.ok ? "ok  " : "FAIL", label.c_str(), c.bytes, c.ok ? " identical" : ", ",
+                c.ok ? "" : c.why.c_str());
+}
+
+// Inkling 2 Mini's attention: 24 heads on 8 K / V heads of 128, d_rel 16; the stream 2304
+constexpr int H = 24, KV = 8, D = 128, d_rel = 16, C = 2304, HD = H * D, KD = KV * D, HR = H * d_rel;
+constexpr float qk_clip = 22.6f, rel_clip = 8.0f, eps = 1e-6f, alpha = 0.1f, n_floor = 64.0f;
+constexpr float k_scale = 16.0f, v_scale = 32.0f;   // (fast_token_launches': qk_clip <= 28)
+const float qk_scale = 1.0f / std::sqrt((float) D);
+const int kNs[] = {1, 2, 3, 5, 8};
+int g_mma_blocks = 1;   // k::attn_decode_mma_blocks(KV): the engine's splits
+
+struct LayerKind {
+    const char* name;
+    bool full;
+    int window, extent;
+    int nmat;    // the fused product's row: sliding q | k | v | r | gate, full q | r | gate (the block path's rows)
+    int off_r;   // r's offset in it; the gate follows r
+};
+const LayerKind kSliding{"sliding", false, 1024, 1024, HD + 2 * KD + HR + HD, HD + 2 * KD};
+const LayerKind kFull{"full", true, 1 << 30, 512, HD + HR + HD, HD};
+
+// a step's rows: slot [N] (a shuffled subset of NS slots), pos [N], the slots' ring sizes cap [NS] (a full layer:
+// the slot's context, the cache's rows)
+struct Rows {
+    int N = 0, NS = 0;
+    std::vector<int> slot, pos, cap;
+    std::string label() const {
+        std::string s = "N=" + std::to_string(N) + " slots";
+        for (int t = 0; t < N; ++t) s += (t ? "," : " ") + std::to_string(slot[t]);
+        s += " pos";
+        for (int t = 0; t < N; ++t) s += (t ? "," : " ") + std::to_string(pos[t]);
+        return s;
+    }
+};
+Rows make_rows(int N, const LayerKind& L) {
+    Rows R;
+    R.N = N, R.NS = N + 3;
+    for (int s = 0; s < R.NS; ++s) R.cap.push_back(L.full ? 256 + 320 * s : L.window + 8 + 24 * s);
+    std::vector<int> perm(R.NS);
+    std::iota(perm.begin(), perm.end(), 0);
+    std::shuffle(perm.begin(), perm.end(), rng);
+    R.slot.assign(perm.begin(), perm.begin() + N);
+    for (int t = 0; t < N; ++t) {
+        const int cap = R.cap[R.slot[t]];
+        int p = 0;
+        if (!L.full) {
+            switch (t % 6) {
+                case 0: p = 2 * cap + (int) (rng() % cap); break;       // past the ring: it wraps
+                case 1: p = 0; break;                                    // a first token
+                case 2: p = 1 + (int) (rng() % 40); break;               // a few tokens
+                case 3: p = L.window - 1 - (int) (rng() % 64); break;    // under the window, no wrap yet
+                case 4: p = 40000 + (int) (rng() % 5000); break;         // deep: wrapped many times
+                default: p = cap + (int) (rng() % 16); break;            // just wrapped
+            }
+        } else {
+            switch (t % 5) {
+                case 0: p = cap - 1; break;                              // the context's last position
+                case 1: p = 0; break;
+                case 2: p = 1 + (int) (rng() % 40); break;
+                case 3: p = cap / 2 + (int) (rng() % 7); break;
+                default: p = cap - 2 - (int) (rng() % 30); break;
+            }
+        }
+        R.pos.push_back(p);
+    }
+    return R;
+}
+
+// the NS slots' K and V caches with random contents, twice (A: the rows kernels', B: the reference's), and the
+// device tables of A's base pointers
+template <class KVT>
+struct Caches {
+    const Rows& R;
+    std::vector<KVT*> kA, vA, kB, vB;
+    KVT **tabK = nullptr, **tabV = nullptr;
+    int* cap_d = nullptr;
+    explicit Caches(const Rows& rows) : R(rows) {
+        for (int s = 0; s < R.NS; ++s) {
+            std::vector<KVT> hk((size_t) R.cap[s] * KD), hv((size_t) R.cap[s] * KD);
+            fill(hk), fill(hv);
+            kA.push_back(dev(hk)), kB.push_back(dev(hk)), vA.push_back(dev(hv)), vB.push_back(dev(hv));
+        }
+        tabK = dev(kA), tabV = dev(vA), cap_d = dev(R.cap);
+    }
+    void compare(Cmp& c) const {
+        for (int s = 0; s < R.NS; ++s) {
+            c.same("K cache of slot " + std::to_string(s), kA[s], kB[s], (size_t) R.cap[s] * KD);
+            c.same("V cache of slot " + std::to_string(s), vA[s], vB[s], (size_t) R.cap[s] * KD);
+        }
+    }
+    ~Caches() {
+        for (auto* v : {&kA, &vA, &kB, &vB})
+            for (KVT* p : *v) cudaFree(p);
+        cudaFree(tabK), cudaFree(tabV), cudaFree(cap_d);
+    }
+};
+
+// ---- prep_qkv_r_*_rows against prep_qkv_r_*_at a row
+
+// one step's prep inputs: the fused product's rows (q at 0, r at off_r, the gate after r), k and v after their
+// convs, the sinks' input; the layer's clip scales and sink weights
+struct PrepIn {
+    int N, ld;
+    std::vector<float> qkv, kin, vin, sx;
+    PrepIn(int n, int ld_) : N(n), ld(ld_) {
+        qkv = fvec((size_t) N * ld, 3.0f), kin = fvec((size_t) N * KD, 3.0f), vin = fvec((size_t) N * KD, 3.0f);
+        sx = fvec((size_t) N * C);
+    }
+};
+struct LayerW {
+    float *qcl, *rcl, *proj;
+    uint16_t* sw;
+    explicit LayerW(const LayerKind& L) {
+        qcl = dev(fvec(HD, 0.5f, 1.0f)), rcl = dev(fvec(HR, 0.5f, 1.0f)), proj = dev(fvec((size_t) L.extent * d_rel));
+        std::vector<uint16_t> w((size_t) H * C);
+        for (auto& v : w) v = f2h_host(frand(0.05f));
+        sw = dev(w);
+    }
+    ~LayerW() { cudaFree(qcl), cudaFree(rcl), cudaFree(proj), cudaFree(sw); }
+};
+
+// the rows' prep (A) and the tokens' (B, a row a launch); caps: the cap table (else linear, as cap_tab null)
+template <class KVT>
+void run_prep(const LayerKind& L, const Rows& R, const LayerW& W, Caches<KVT>& cache, bool caps, int ld, float* qA,
+              float* qB, const float* kin, const float* vin, const float* sx, uint16_t* q16A, uint16_t* q16B,
+              float* syA, float* syB, const int* slot_d, const int* pos_d) {
+    constexpr bool fp8 = sizeof(KVT) == 1;
+    const int N = R.N;
+    const int* cap_tab = caps ? cache.cap_d : nullptr;
+    if constexpr (fp8)
+        k::prep_qkv_r_fp8_rows(qA, ld, W.qcl, kin, cache.tabK, vin, cache.tabV, qA + L.off_r, ld, W.rcl, N, H, KV, D,
+                               d_rel, qk_clip, rel_clip, eps, slot_d, pos_d, cap_tab, L.full, alpha, n_floor, k_scale,
+                               v_scale, q16A, 0, W.sw, sx, C, syA);
+    else
+        k::prep_qkv_r_f16_rows(qA, ld, W.qcl, kin, cache.tabK, vin, cache.tabV, qA + L.off_r, ld, W.rcl, N, H, KV, D,
+                               d_rel, qk_clip, rel_clip, eps, slot_d, pos_d, cap_tab, L.full, alpha, n_floor, q16A, 0,
+                               W.sw, sx, C, syA);
+    for (int t = 0; t < N; ++t) {
+        const int s = R.slot[t], kv_cap = caps ? R.cap[s] : 0;
+        float* q = qB + (size_t) t * ld;
+        if constexpr (fp8)
+            k::prep_qkv_r_fp8_at(q, W.qcl, kin + (size_t) t * KD, cache.kB[s], vin + (size_t) t * KD, cache.vB[s],
+                                 q + L.off_r, W.rcl, H, KV, D, d_rel, qk_clip, rel_clip, eps, pos_d + t, L.full, alpha,
+                                 n_floor, kv_cap, k_scale, v_scale, q16B + (size_t) t * HD, 0, W.sw,
+                                 sx + (size_t) t * C, C, syB + (size_t) t * H);
+        else
+            k::prep_qkv_r_f16_at(q, W.qcl, kin + (size_t) t * KD, cache.kB[s], vin + (size_t) t * KD, cache.vB[s],
+                                 q + L.off_r, W.rcl, H, KV, D, d_rel, qk_clip, rel_clip, eps, pos_d + t, L.full, alpha,
+                                 n_floor, kv_cap, q16B + (size_t) t * HD, 0, W.sw, sx + (size_t) t * C, C,
+                                 syB + (size_t) t * H);
+    }
+}
+
+template <class KVT>
+void test_prep_case(const LayerKind& L, int N) {
+    constexpr bool fp8 = sizeof(KVT) == 1;
+    const Rows R = make_rows(N, L);
+    const bool odd = N == 3, caps = !L.full || N % 2;   // (a full layer: its context as the ring, or linear)
+    const int ld = L.nmat + (odd ? 1 : 0);
+    Caches<KVT> cache(R);
+    LayerW W(L);
+    PrepIn in(N, ld);
+    float *qA = dev(in.qkv), *qB = dev(in.qkv), *kin = dev(in.kin), *vin = dev(in.vin), *sx = dev(in.sx);
+    uint16_t *q16A = dev_fill<uint16_t>((size_t) N * HD, 0xFF), *q16B = dev_fill<uint16_t>((size_t) N * HD, 0xFF);
+    float *syA = dev_fill<float>((size_t) N * H, 0xFF), *syB = dev_fill<float>((size_t) N * H, 0xFF);
+    int *slot_d = dev(R.slot), *pos_d = dev(R.pos);
+    run_prep<KVT>(L, R, W, cache, caps, ld, qA, qB, kin, vin, sx, q16A, q16B, syA, syB, slot_d, pos_d);
+    Cmp c;
+    c.same("q | r rows", qA, qB, (size_t) N * ld);
+    c.same("q16", q16A, q16B, (size_t) N * HD);
+    c.same("sinks", syA, syB, (size_t) N * H);
+    cache.compare(c);
+    report(std::string(fp8 ? "prep_qkv_r_fp8_rows " : "prep_qkv_r_f16_rows ") + L.name + (odd ? " odd ld" : "") +
+               (L.full ? (caps ? " caps=ctx" : " linear") : "") + " " + R.label(),
+           c);
+    for (float* p : {qA, qB, kin, vin, sx, syA, syB}) cudaFree(p);
+    cudaFree(q16A), cudaFree(q16B), cudaFree(slot_d), cudaFree(pos_d);
+}
+
+// ---- attn_rows_* against attn_decode_mma_* a row
+
+// the rows' attention (A) and the tokens' (B); ring: the slots' cap table to the rows kernel (the token kernel gets a
+// sliding layer's ring, a full layer's 0, as fast_token_launches passes them)
+template <class KVT>
+void run_attn(const LayerKind& L, const Rows& R, const Caches<KVT>& cache, bool ring, int ns, const uint16_t* q16A,
+              const uint16_t* q16B, const float* qkvA, const float* qkvB, int ld, const float* sinkA,
+              const float* sinkB, const float* proj, bool gated, float* scrA, float* scrB, float* outA, float* outB,
+              uint16_t* o16A, uint16_t* o16B, const int* slot_d, const int* pos_d) {
+    constexpr bool fp8 = sizeof(KVT) == 1;
+    const int N = R.N;
+    const int* cap_tab = ring ? cache.cap_d : nullptr;
+    const float* rA = qkvA + L.off_r;
+    const float* gA = gated ? rA + HR : nullptr;
+    if constexpr (fp8)
+        k::attn_rows_fp8(q16A, rA, ld, sinkA, cache.tabK, cache.tabV, cap_tab, slot_d, pos_d, N, H, KV, ns,
+                         qk_scale / k_scale, 1.0f / v_scale, proj, d_rel, L.extent, L.window, scrA, outA, gA, ld,
+                         gated ? o16A : nullptr, 0);
+    else
+        k::attn_rows_f16(q16A, rA, ld, sinkA, cache.tabK, cache.tabV, cap_tab, slot_d, pos_d, N, H, KV, ns, qk_scale,
+                         proj, d_rel, L.extent, L.window, scrA, outA, gA, ld, gated ? o16A : nullptr, 0);
+    for (int t = 0; t < N; ++t) {
+        const int s = R.slot[t], kv_cap = L.full ? 0 : R.cap[s];
+        const float* r = qkvB + (size_t) t * ld + L.off_r;
+        const float* g = gated ? r + HR : nullptr;
+        uint16_t* o16 = gated ? o16B + (size_t) t * HD : nullptr;
+        if constexpr (fp8)
+            k::attn_decode_mma_fp8(q16B + (size_t) t * HD, r, sinkB + (size_t) t * H, cache.kB[s], cache.vB[s], kv_cap,
+                                   H, KV, pos_d + t, 0, ns, qk_scale / k_scale, 1.0f / v_scale, proj, d_rel, L.extent,
+                                   L.window, scrB, outB + (size_t) t * HD, g, o16, 0);
+        else
+            k::attn_decode_mma_f16(q16B + (size_t) t * HD, r, sinkB + (size_t) t * H, cache.kB[s], cache.vB[s], kv_cap,
+                                   H, KV, pos_d + t, 0, ns, qk_scale, proj, d_rel, L.extent, L.window, scrB,
+                                   outB + (size_t) t * HD, g, o16, 0);
+    }
+}
+int splits(const LayerKind& L, int N) {   // the engine's (fast_token_launches'), but a few at N = 5: runs of steps
+    if (N == 5) return 3;
+    return L.full ? g_mma_blocks : std::min(g_mma_blocks, std::max(1, (L.window + 63) / 64));
+}
+
+template <class KVT>
+void test_attn_case(const LayerKind& L, int N) {
+    constexpr bool fp8 = sizeof(KVT) == 1;
+    const Rows R = make_rows(N, L);
+    const bool odd = N == 3, gated = N != 2, ring = !L.full || N % 2;
+    const int ld = L.nmat + (odd ? 1 : 0), ns = splits(L, N);
+    Caches<KVT> cache(R);
+    LayerW W(L);
+    std::vector<uint16_t> q16((size_t) N * HD);
+    for (auto& v : q16) v = f2h_host(frand(fp8 ? 2.0f : 4.0f));
+    uint16_t* q16_d = dev(q16);
+    float *qkv = dev(fvec((size_t) N * ld, 2.0f)), *sink = dev(fvec((size_t) N * H, 3.0f));
+    float *scrA = dev_fill<float>(k::attn_rows_scratch(H, N, ns), 0), *scrB = dev_fill<float>(k::attn_decode_mma_scratch(H, ns), 0);
+    float *outA = dev_fill<float>((size_t) N * HD, 0xFF), *outB = dev_fill<float>((size_t) N * HD, 0xFF);
+    uint16_t *o16A = dev_fill<uint16_t>((size_t) N * HD, 0xFF), *o16B = dev_fill<uint16_t>((size_t) N * HD, 0xFF);
+    int *slot_d = dev(R.slot), *pos_d = dev(R.pos);
+    run_attn<KVT>(L, R, cache, ring, ns, q16_d, q16_d, qkv, qkv, ld, sink, sink, W.proj, gated, scrA, scrB, outA, outB,
+                  o16A, o16B, slot_d, pos_d);
+    Cmp c;
+    c.same("out", outA, outB, (size_t) N * HD);
+    c.same("out16", o16A, o16B, (size_t) N * HD);
+    report(std::string(fp8 ? "attn_rows_fp8 " : "attn_rows_f16 ") + L.name + " n_split " + std::to_string(ns) +
+               (gated ? " gate+out16" : " no gate") + (odd ? " odd ld" : "") +
+               (L.full ? (ring ? " caps=ctx" : " linear") : "") + " " + R.label(),
+           c);
+    for (float* p : {qkv, sink, scrA, scrB, outA, outB}) cudaFree(p);
+    cudaFree(q16_d), cudaFree(o16A), cudaFree(o16B), cudaFree(slot_d), cudaFree(pos_d);
+}
+
+// ---- conv_rows against conv4_res of one token a row
+
+struct ConvKind {
+    const char* name;
+    int C;
+    bool dyn, res;
+    int x_ld;
+};
+const ConvKind kConvs[] = {
+    {"k conv (sliding: x in the fused product's rows)", KD, false, false, kSliding.nmat},
+    {"k conv (full: dynamic taps)", KD, true, false, KD},
+    {"attn conv (+ the stream)", C, false, true, C},
+};
+
+void test_conv_case(const ConvKind& K, int N) {
+    const int Cc = K.C, NS = N + 3, d_ld = KV * 4, steps = 3, y_ld = Cc + (N == 3 ? 3 : 0);
+    std::vector<int> perm(NS);
+    std::iota(perm.begin(), perm.end(), 0);
+    std::shuffle(perm.begin(), perm.end(), rng);
+    const std::vector<int> slot(perm.begin(), perm.begin() + N);
+    std::vector<float*> hA, hB;
+    for (int s = 0; s < NS; ++s) {
+        const auto h = fvec((size_t) 3 * Cc, 2.0f);
+        hA.push_back(dev(h)), hB.push_back(dev(h));
+    }
+    float** tab = dev(hA);
+    int* slot_d = dev(slot);
+    float* w = dev(fvec((size_t) Cc * 4));
+    Cmp c;
+    for (int step = 0; step < steps; ++step) {   // (the histories carried over the steps)
+        float *x = dev(fvec((size_t) N * K.x_ld, 2.0f)), *dyn = dev(fvec((size_t) N * d_ld)),
+              *res = dev(fvec((size_t) N * Cc, 2.0f));
+        float *yA = dev_fill<float>((size_t) N * y_ld, 0xFF), *yB = dev_fill<float>((size_t) N * y_ld, 0xFF);
+        k::conv_rows(x, K.x_ld, tab, slot_d, w, K.dyn ? dyn : nullptr, d_ld, KV, N, Cc, K.res ? res : nullptr, Cc, yA,
+                     y_ld, 0);
+        for (int t = 0; t < N; ++t)
+            k::conv4_res(x + (size_t) t * K.x_ld, hB[slot[t]], w, K.dyn ? dyn + (size_t) t * d_ld : nullptr, KV, 1, Cc,
+                         K.res ? res + (size_t) t * Cc : nullptr, yB + (size_t) t * y_ld, 0);
+        c.same("y of step " + std::to_string(step), yA, yB, (size_t) N * y_ld);
+        for (int s = 0; s < NS; ++s)
+            c.same("history of slot " + std::to_string(s) + " after step " + std::to_string(step), hA[s], hB[s],
+                   (size_t) 3 * Cc);
+        for (float* p : {x, dyn, res, yA, yB}) cudaFree(p);
+    }
+    std::string label = std::string("conv_rows ") + K.name + (N == 3 ? " y_ld odd" : "") + ", 3 steps, N=" +
+                        std::to_string(N) + " slots";
+    for (int t = 0; t < N; ++t) label += (t ? "," : " ") + std::to_string(slot[t]);
+    report(label, c);
+    for (int s = 0; s < NS; ++s) cudaFree(hA[s]), cudaFree(hB[s]);
+    cudaFree(tab), cudaFree(slot_d), cudaFree(w);
+}
+
+// ---- prep then attention, two decode steps: the rows' path (prep_qkv_r_*_rows -> attn_rows_*) against the tokens'
+// (prep_qkv_r_*_at -> attn_decode_mma_* a row), the K and V each step writes read by its attention
+
+template <class KVT>
+void test_step_case(const LayerKind& L, int N) {
+    constexpr bool fp8 = sizeof(KVT) == 1;
+    Rows R = make_rows(N, L);
+    for (int& p : R.pos) p = std::max(0, p - 1);   // (steps at pos, pos + 1: a full layer's within its context)
+    const int ld = L.nmat, ns = splits(L, N);
+    Caches<KVT> cache(R);
+    LayerW W(L);
+    int* slot_d = dev(R.slot);
+    float *scrA = dev_fill<float>(k::attn_rows_scratch(H, N, ns), 0), *scrB = dev_fill<float>(k::attn_decode_mma_scratch(H, ns), 0);
+    Cmp c;
+    std::string first_pos = R.label();
+    for (int step = 0; step < 2; ++step) {
+        std::vector<int> pos = R.pos;
+        for (int& p : pos) p += step;
+        int* pos_d = dev(pos);
+        PrepIn in(N, ld);
+        float *qA = dev(in.qkv), *qB = dev(in.qkv), *kin = dev(in.kin), *vin = dev(in.vin), *sx = dev(in.sx);
+        uint16_t *q16A = dev_fill<uint16_t>((size_t) N * HD, 0xFF), *q16B = dev_fill<uint16_t>((size_t) N * HD, 0xFF);
+        float *syA = dev_fill<float>((size_t) N * H, 0xFF), *syB = dev_fill<float>((size_t) N * H, 0xFF);
+        float *outA = dev_fill<float>((size_t) N * HD, 0xFF), *outB = dev_fill<float>((size_t) N * HD, 0xFF);
+        uint16_t *o16A = dev_fill<uint16_t>((size_t) N * HD, 0xFF), *o16B = dev_fill<uint16_t>((size_t) N * HD, 0xFF);
+        run_prep<KVT>(L, R, W, cache, true, ld, qA, qB, kin, vin, sx, q16A, q16B, syA, syB, slot_d, pos_d);
+        run_attn<KVT>(L, R, cache, !L.full, ns, q16A, q16B, qA, qB, ld, syA, syB, W.proj, true, scrA, scrB, outA, outB,
+                      o16A, o16B, slot_d, pos_d);
+        const std::string st = " of step " + std::to_string(step);
+        c.same("out" + st, outA, outB, (size_t) N * HD);
+        c.same("out16" + st, o16A, o16B, (size_t) N * HD);
+        c.same("q | r rows" + st, qA, qB, (size_t) N * ld);
+        cache.compare(c);
+        for (float* p : {qA, qB, kin, vin, sx, syA, syB, outA, outB}) cudaFree(p);
+        cudaFree(q16A), cudaFree(q16B), cudaFree(o16A), cudaFree(o16B), cudaFree(pos_d);
+    }
+    report(std::string(fp8 ? "prep + attn fp8 " : "prep + attn f16 ") + L.name + ", 2 steps, " + first_pos, c);
+    cudaFree(slot_d), cudaFree(scrA), cudaFree(scrB);
+}
+
+}  // namespace
+
+int main() {
+    cudaDeviceProp p{};
+    CU(cudaGetDeviceProperties(&p, 0));
+    std::printf("ik2_rows_test on %s (sm_%d%d)\n", p.name, p.major, p.minor);
+    g_mma_blocks = k::attn_decode_mma_blocks(KV);
+    std::printf("attn_decode_mma_blocks(%d) = %d (the engine's splits; a sliding layer's min(that, %d))\n", KV,
+                g_mma_blocks, (kSliding.window + 63) / 64);
+    for (const LayerKind* L : {&kSliding, &kFull})
+        for (int N : kNs) test_prep_case<uint8_t>(*L, N), test_prep_case<uint16_t>(*L, N);
+    for (const LayerKind* L : {&kSliding, &kFull})
+        for (int N : kNs) test_attn_case<uint8_t>(*L, N), test_attn_case<uint16_t>(*L, N);
+    for (const ConvKind& K : kConvs)
+        for (int N : kNs) test_conv_case(K, N);
+    for (const LayerKind* L : {&kSliding, &kFull})
+        for (int N : kNs) test_step_case<uint8_t>(*L, N), test_step_case<uint16_t>(*L, N);
+    CU(cudaDeviceSynchronize());
+    if (g_fail) std::printf("FAILED: %d of %d case(s)\n", g_fail, g_cases);
+    else std::printf("all %d cases passed\n", g_cases);
+    return g_fail ? 1 : 0;
+}
diff --git a/tests/ik2_serve_fake.cpp b/tests/ik2_serve_fake.cpp
new file mode 100644
index 0000000..e27c153
--- /dev/null
+++ b/tests/ik2_serve_fake.cpp
@@ -0,0 +1,126 @@
+// tests/ik2_serve_fake.cpp - maya-ik2 --serve --parallel N's loop (src/ik2/ik2_serve.hpp, sv::serve_loop: the engine's
+// own code) over a stand-in model, no GPU: the whole multi protocol on stdin / stdout as the engine speaks it, for
+// batching-build/m3_drive.py's cases offline.  A slot's state is a hash of the tokens in it (zero(): empty), so a
+// token depends on exactly what its slot holds: a request's tokens come out the same alone or beside others only when
+// the loop keeps every slot's state right - a stopped prompt's leftovers, a wrong snapshot or two rows on one slot
+// change them.  A snapshot copies the state; a prompt piece and a decode step take a time (--piece-ms a 2048-token
+// piece, --step-ms a step) so that lines arrive while the loop is busy, as with the model.
+//   g++ -std=c++20 -O1 -pthread -I src/ik2 tests/ik2_serve_fake.cpp -o ik2_serve_fake
+//   ik2_serve_fake --serve --parallel 2 [--max-context 16384] [--chunk 2048] [--piece-ms 40] [--step-ms 4]
+//                  [--read-ms N]   (N: a piece's least time - so a timed STOP lands inside a short prompt's read)
+#include "ik2_serve.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace sv = ik2::serve;
+
+namespace {
+
+constexpr int kVocab = 200058;
+constexpr uint64_t kEmpty = 0x9E3779B97F4A7C15ull;
+
+uint64_t mix(uint64_t h, uint64_t t) {
+    h ^= t + 0x632BE59BD9B4E019ull + (h << 6) + (h >> 2);
+    h *= 0xff51afd7ed558ccdull;
+    return h ^ (h >> 33);
+}
+int tok_of(uint64_t h, int k) { return (int) (mix(h, (uint64_t) k + 7) % 199000) + 1000; }   // (no eos: 199999)
+
+struct Fake {
+    int n_slots = 2, piece_ms = 40, step_ms = 4, read_ms = 0;   // (read_ms: a piece's least time, --read-ms)
+    std::vector<uint64_t> state, pool;
+    Fake(int n, int n_snaps) : n_slots(n), state((size_t) n, kEmpty), pool((size_t) n_snaps, 0) {}
+    void zero(int s) { state[(size_t) s] = kEmpty; }
+    void snap(int i, int s, int /*pos*/, bool save) {   // (the state after pos tokens: the slot's hash then)
+        if (save) pool[(size_t) i] = state[(size_t) s];
+        else state[(size_t) s] = pool[(size_t) i];
+    }
+    bool pictures(const sv::Req& r, std::vector<uint64_t>&, std::string& err) {
+        if (r.pictures.empty()) return true;
+        err = "the stand-in model takes no pictures";
+        return false;
+    }
+    void pictures_done() {}
+    // the softcapped logits of a state: its token 30 (capped), 4 more below it, the rest low
+    static void logits_of(uint64_t h, std::vector<float>& lo) {
+        lo.assign((size_t) kVocab, -20.0f);
+        for (int k = 0; k < 5; ++k) lo[(size_t) tok_of(h, k)] = 29.0f - 0.5f * (float) k;
+    }
+    void read(int s, const std::vector<int>& ids, size_t a, int T, bool last, std::vector<float>& logits) {
+        for (int t = 0; t < T; ++t) state[(size_t) s] = mix(state[(size_t) s], (uint64_t) ids[a + (size_t) t]);
+        std::this_thread::sleep_for(std::chrono::microseconds(std::max((long) piece_ms * 1000 * T / 2048, (long) read_ms * 1000)));
+        if (last) logits_of(state[(size_t) s], logits);
+    }
+    void step(const std::vector<sv::StepRow>& rows, std::vector<sv::StepOut>& out) {
+        std::vector<int> seen;
+        out.assign(rows.size(), sv::StepOut{});
+        for (size_t r = 0; r < rows.size(); ++r) {
+            const sv::StepRow& x = rows[r];
+            for (int s : seen)
+                if (s == x.slot) fatal("two rows on one slot");
+            seen.push_back(x.slot);
+            uint64_t& h = state[(size_t) x.slot];
+            h = mix(h, (uint64_t) x.tok);
+            out[r].argmax = tok_of(h, 0);
+            if (x.sampled)
+                for (int k = 0; k < 5; ++k) out[r].cands.push_back({29.0f - 0.5f * (float) k, tok_of(h, k)});
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(step_ms));
+    }
+    bool signal() { return false; }
+    double seconds() {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void print(const std::string& l) {
+        std::fwrite(l.data(), 1, l.size(), stdout);
+        std::fputc('\n', stdout);
+    }
+    void flush() { std::fflush(stdout); }
+    void log(const std::string& l) { std::fprintf(stderr, "%s\n", l.c_str()); }
+    [[noreturn]] void fatal(const std::string& m) {
+        std::fprintf(stderr, "ik2_serve_fake: %s\n", m.c_str());
+        std::exit(1);
+    }
+};
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    int n = 2, chunk = 2048, piece_ms = 40, step_ms = 4, read_ms = 0;
+    long long ctx = 16384;
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        auto next = [&]() { return i + 1 < argc ? std::atoll(argv[++i]) : 0LL; };
+        if (a == "--parallel") n = (int) next();
+        else if (a == "--max-context") ctx = next();
+        else if (a == "--chunk") chunk = (int) next();
+        else if (a == "--piece-ms") piece_ms = (int) next();
+        else if (a == "--step-ms") step_ms = (int) next();
+        else if (a == "--read-ms") read_ms = (int) next();
+        else if (a == "--serve") {
+        } else {
+            std::fprintf(stderr, "ik2_serve_fake: unknown argument %s\n", a.c_str());
+            return 2;
+        }
+    }
+    Fake be(n, 8);
+    be.piece_ms = piece_ms, be.step_ms = step_ms, be.read_ms = read_ms;
+    sv::LoopConfig cf;
+    cf.n_slots = n, cf.n_snaps = 8, cf.vocab = kVocab, cf.ctx = ctx, cf.chunk = chunk, cf.piece = chunk, cf.cand_k = 1000;
+    cf.eos = {199999};
+    std::printf("INFO engine=ik2-fake engine_kind=ik2 ctx=%lld parallel=%d\n", ctx, n);
+    std::printf("READY %lld stop multi=%d\n", ctx, n);
+    std::fflush(stdout);
+    static sv::Lines in;
+    in.start(std::cin);
+    sv::serve_loop(be, in, cf);
+    return 0;
+}
diff --git a/tests/ik2_serve_stop_probe.cpp b/tests/ik2_serve_stop_probe.cpp
new file mode 100644
index 0000000..9186a52
--- /dev/null
+++ b/tests/ik2_serve_stop_probe.cpp
@@ -0,0 +1,59 @@
+// tests/ik2_serve_stop_probe.cpp - regression test for a STOP arriving during the final prefill read.
+// STOP 2 and then GEN 3 arrive inside the only read of rid 1 while rid 2 waits.
+// Exit 0: rid 2 cancels without a token and rid 3 completes.
+// Exit 1: rid 2 emitted and finished "length"; exit 2: another unexpected result.
+//   g++ -std=c++20 -O1 -pthread -I src/ik2 tests/ik2_serve_stop_probe.cpp -o ik2_serve_stop_probe
+#define main shipped_fake_main
+#include "ik2_serve_fake.cpp"
+#undef main
+
+struct ProbeFake : Fake {
+    sv::Lines& input;
+    bool injected = false;
+    explicit ProbeFake(sv::Lines& lines) : Fake(2, 8), input(lines) {
+        piece_ms = step_ms = 0;
+    }
+
+    void read(int s, const std::vector<int>& ids, size_t a, int count, bool last, std::vector<float>& logits) {
+        if (!injected && ids == std::vector<int>{11} && last) {
+            injected = true;
+            input.push("STOP 2");
+            input.push("GEN 1 temperature=0 rid=3 33");
+            input.end();
+            std::puts("PROBE queued STOP 2 then GEN 3 inside final read of rid 1");
+        }
+        Fake::read(s, ids, a, count, last, logits);
+    }
+
+    void print(const std::string& line) {
+        token2 |= line.starts_with("T 2 ");
+        cancel2 |= line.starts_with("DONE 2 0 ") && line.find(" cancel ") != std::string::npos;
+        length2 |= line.starts_with("DONE 2 1 ") && line.find(" length ") != std::string::npos;
+        length3 |= line.starts_with("DONE 3 1 ") && line.find(" length ") != std::string::npos;
+        Fake::print(line);
+    }
+    bool token2 = false, cancel2 = false, length2 = false, length3 = false;
+};
