+void decode_rows(Model& M, const int* tok, const int* slot, const int* pos, int R, OutMode out_mode,
+                 std::vector<float>& logits_out, std::vector<int>* argmax_out) {
+    if (R == 1) {
+        if (g_rows.ready) rows_validate(M, slot, pos, 1);
+        bind_slot(M, slot[0]);
+        fast_token(M, tok[0], pos[0], out_mode, logits_out, argmax_out);
+        return;
+    }
+    fast_rows(M, tok, slot, pos, R, out_mode, logits_out, argmax_out);
