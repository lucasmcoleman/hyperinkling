+int main() {
+    sv::Lines input;
+    input.push("GEN 1 temperature=0 rid=1 11");
+    input.push("GEN 1 temperature=0 rid=2 22");
+    ProbeFake backend(input);
+    sv::LoopConfig config;
+    config.n_slots = 2;
+    config.n_snaps = 8;
+    config.vocab = kVocab;
+    config.ctx = 16384;
+    config.chunk = config.piece = 2048;
+    config.cand_k = 1000;
+    config.eos = {199999};
+    sv::serve_loop(backend, input, config);
+    if (!backend.injected || !backend.length3) return 2;
+    if (!backend.token2 && backend.cancel2) return 0;
+    if (backend.token2 && backend.length2 && !backend.cancel2) {
+        std::puts("REPRODUCED: queued rid 2 emitted one token and DONE length after STOP 2 was queued");
+        return 1;
+    }
