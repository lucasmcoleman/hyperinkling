+#include <vector>
+
+namespace ik2::serve {
+
+// ---- stdin
+
+struct Line {
+    uint64_t seq = 0;   // its place among the lines (1, 2, ...)
+    std::string text;
+};
+
+struct Lines {
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<Line> q;
+    bool eof = false;
+    uint64_t n = 0;   // lines so far (under mu)
+    void push(std::string l) {
+        if (!l.empty() && l.back() == '\r') l.pop_back();
+        std::lock_guard<std::mutex> lk(mu);
+        q.push_back({++n, std::move(l)});
+        cv.notify_one();
+    }
+    void end() {
+        std::lock_guard<std::mutex> lk(mu);
+        eof = true;
+        cv.notify_one();
+    }
+    bool try_next(Line& out) {   // (a line if one is waiting, without waiting)
+        std::lock_guard<std::mutex> lk(mu);
+        if (q.empty()) return false;
+        out = std::move(q.front());
+        q.pop_front();
+        return true;
+    }
+    bool next(Line& out) {   // (waits; false at the end of the input)
+        std::unique_lock<std::mutex> lk(mu);
+        cv.wait(lk, [&] { return !q.empty() || eof; });
+        if (q.empty()) return false;
+        out = std::move(q.front());
+        q.pop_front();
+        return true;
+    }
+    bool ended() {
+        std::lock_guard<std::mutex> lk(mu);
+        return eof && q.empty();
+    }
+    // the reader thread (detached: at QUIT it may outlive the loop - the Lines must then outlive it, e.g. a static)
+    void start(std::istream& in) {
+        std::thread([this, &in] {
+            std::string l;
+            while (std::getline(in, l)) push(std::move(l));
+            end();
+        }).detach();
+    }
+};
+
+// ---- a request's line
+
+// a whole number, all of s: an optional '-', then decimal digits, within long long
+inline bool whole(const std::string& s, long long& v) {
+    size_t i = !s.empty() && s[0] == '-' ? 1 : 0;
+    if (i == s.size()) return false;
+    long long x = 0;
+    for (; i < s.size(); ++i) {
+        if (s[i] < '0' || s[i] > '9') return false;
+        const int d = s[i] - '0';
+        if (x > (LLONG_MAX - d) / 10) return false;
+        x = x * 10 + d;
+    }
+    v = s[0] == '-' ? -x : x;
+    return true;
+}
+// a finite real number, all of s
+inline bool real(const std::string& s, double& v) {
+    if (s.empty()) return false;
+    char* e = nullptr;
+    errno = 0;
+    v = std::strtod(s.c_str(), &e);
+    return errno == 0 && e == s.c_str() + s.size() && std::isfinite(v);
+}
+
+inline std::string clip(const std::string& s) { return s.size() > 24 ? s.substr(0, 24) + "..." : s; }
+
+struct Req {
+    uint64_t seq = 0;          // its line's place in the input
+    int rid = -1;
+    int max_new = 0;
+    double temp = 0, top_p = 1;
+    int top_k = 0;
+    long long seed = -1;       // (below 0: none given)
+    bool geni = false;
+    std::string pictures;      // GENI: the pictures' file
+    std::vector<int> ids;
+    size_t n_ids = 0;          // the ids as written (a refused one's DONE)
+    bool cancel = false;       // a STOP for it came while it waited
+};
+
+// "GEN <max_new> [key=value ...] <ids>" (GENI: the pictures' file before the ids) -> "" and r, else why not (r.rid
+// set when the line had a valid one: the refusal is that request's).  Keys this engine does not use are skipped, as
+// the one-sequence loop skips them.
+inline std::string parse_gen(const std::string& line, int n_vocab, long long ctx, Req& r) {
+    r = Req{};
+    std::istringstream is(line);
+    std::string cmd, max_s, w, ids_s, bad;
+    is >> cmd;
+    r.geni = cmd == "GENI";
+    if (cmd != "GEN" && !r.geni) return "not a GEN line";
+    is >> max_s;
+    while (is >> w) {
+        const size_t eq = w.find('=');
+        if (eq == std::string::npos) {
+            if (r.geni && r.pictures.empty() && ids_s.empty() && w.find_first_not_of("0123456789,-") != std::string::npos)
+                r.pictures = w;
+            else
+                ids_s = w;
+            continue;
+        }
+        const std::string k = w.substr(0, eq), v = w.substr(eq + 1);
+        long long x = 0;
+        double d = 0;
+        auto fail = [&](const std::string& why) {
+            if (bad.empty()) bad = why;
+        };
+        if (k == "rid") {
+            if (whole(v, x) && x >= 0 && x <= INT_MAX) r.rid = (int) x;
+            else fail("rid=" + clip(v) + " is not a whole number 0 or more");
+        } else if (k == "temperature") {
+            if (real(v, d)) r.temp = d;
+            else fail("temperature=" + clip(v) + " is not a finite number");
+        } else if (k == "top_p") {
+            if (real(v, d)) r.top_p = d;
+            else fail("top_p=" + clip(v) + " is not a finite number");
+        } else if (k == "top_k") {
+            if (whole(v, x) && x >= 0 && x <= INT_MAX) r.top_k = (int) x;
+            else fail("top_k=" + clip(v) + " is not a whole number 0 or more");
+        } else if (k == "seed") {
+            if (whole(v, x)) r.seed = x;
+            else fail("seed=" + clip(v) + " is not a whole number");
+        }
+    }
+    r.n_ids = ids_s.empty() ? 0 : (size_t) std::count(ids_s.begin(), ids_s.end(), ',') + 1;
+    if (r.rid < 0)
+        return bad.rfind("rid=", 0) == 0 ? bad : "expected rid=<id> in each GEN line (this engine runs requests at once)";
+    if (!bad.empty()) return bad;
+    long long mn = 0;
+    if (!whole(max_s, mn) || mn < 0) return "max_new must be a whole number, 0 or more (not '" + clip(max_s) + "')";
+    if (ids_s.empty() || ids_s == "-") return "an empty prompt";
+    for (size_t i = 0;;) {
+        const size_t c = ids_s.find(',', i);
+        const std::string t = ids_s.substr(i, c == std::string::npos ? std::string::npos : c - i);
+        long long x = 0;
+        if (t.empty() || t[0] == '-' || !whole(t, x))
+            return "prompt token " + std::to_string(r.ids.size()) + " ('" + clip(t) + "') is not a token id";
+        if (x >= n_vocab)
+            return "prompt token " + std::to_string(r.ids.size()) + " (" + clip(t) + ") is not in the vocabulary (0 .. " +
+                   std::to_string(n_vocab - 1) + ")";
+        r.ids.push_back((int) x);
+        if (c == std::string::npos) break;
+        i = c + 1;
+    }
+    if ((long long) r.ids.size() > ctx || mn > ctx - (long long) r.ids.size())
+        return "the prompt and max_tokens pass the context (" + std::to_string(ctx) + ")";
+    r.max_new = (int) mn;
+    return "";
+}
+
+// ---- the lines in order: requests, STOP <rid>, STOP
+// (Precondition of the raw protocol: a rid is unique among live requests - serve/server.py issues them from one
+//  counter.  Two live GENs with one rid give ambiguous tagged output, and the second's registration (started) replaces
+//  the first's cancel flag.)
+
+struct Control {
+    int n_vocab = 0;
+    long long ctx = 0;
+    std::function<void(const std::string&)> out;   // a line for stdout (a refused or retired request's ERR / DONE)
+    std::deque<Req> waiting;                       // valid requests not given a slot yet, in order
+    std::map<int, bool*> active;                   // rid -> the cancel flag of a request being read or decoding
+    bool quit = false;
+
+    void done_cancel(int rid, size_t n) {   // (a request that never ran: its DONE - nothing generated)
+        out("DONE " + std::to_string(rid) + " 0 " + std::to_string(n) + " 0 0 cancel 0 0 0");
+    }
+    void stop_all() {   // (STOP, SIGUSR1: every live request - each one's line came before)
+        for (Req& r : waiting) r.cancel = true;
+        for (auto& a : active) *a.second = true;
+    }
+    void stop(int rid) {
+        for (Req& r : waiting)
+            if (r.rid == rid) r.cancel = true;
+        const auto it = active.find(rid);
+        if (it != active.end()) *it->second = true;
+    }
+    bool live(int rid) const {
+        if (active.count(rid)) return true;
+        for (const Req& r : waiting)
+            if (r.rid == rid) return true;
+        return false;
+    }
+    void line(const Line& l) {
+        const std::string& t = l.text;
+        if (t == "STOP") return stop_all();
+        if (t.rfind("STOP ", 0) == 0) {
+            long long x = 0;
+            if (whole(t.substr(5), x) && x >= 0 && x <= INT_MAX) stop((int) x);
+            return;
+        }
+        std::istringstream is(t);
+        std::string cmd;
+        is >> cmd;
+        if (cmd == "QUIT") {
+            quit = true;
+            return;
+        }
+        if (cmd != "GEN" && cmd != "GENI") return;   // (PAUSE / WRAP and the like: not offered in READY)
+        Req r;
+        const std::string err = parse_gen(t, n_vocab, ctx, r);
+        if (!err.empty()) {
+            if (r.rid >= 0) {
+                out("ERR " + std::to_string(r.rid) + " " + err);
+                done_cancel(r.rid, r.n_ids);
+            } else {
+                out("ERR " + err);
+            }
+            return;
+        }
+        r.seq = l.seq;
+        waiting.push_back(std::move(r));
+    }
+    // every stopped waiting request out of the queue, its DONE written; how many
+    int retire() {
+        int n = 0;
+        for (auto it = waiting.begin(); it != waiting.end();) {
+            if (!it->cancel) {
+                ++it;
+                continue;
+            }
+            done_cancel(it->rid, it->ids.size());
+            it = waiting.erase(it);
+            ++n;
+        }
+        return n;
+    }
+    bool take(Req& r) {   // (the first waiting request, out of the queue)
+        if (waiting.empty()) return false;
+        r = std::move(waiting.front());
+        waiting.pop_front();
+        return true;
+    }
+    void started(int rid, bool* cancel) { active[rid] = cancel; }
+    void ended(int rid) { active.erase(rid); }
+};
+
+// ---- the slots and the snapshots
+
+struct Book {
+    struct Slot {
+        std::vector<int> hist;        // the tokens in the slot's state, positions 0 ..
+        std::vector<uint64_t> sig;    // a picture row's hash at its position (shorter than hist: the rest are tokens)
+        bool busy = false;
+        unsigned long long used = 0;  // (when last given back: a clock)
+    };
+    struct Snap {
+        int slot = -1, pos = -1;      // pos -1: empty; else the slot's state after hist[0 .. pos)
+        unsigned long long used = 0;
+    };
+    struct Plan {
+        int slot = -1;     // -1: every slot busy
+        size_t from = 0;   // the prompt's tokens kept (not read again)
+        int snap = -1;     // the snapshot that keeps them (when the slot's history is longer)
+    };
+    enum class Act {
+        kKeep,      // the prompt extends the slot's history: nothing to do
+        kRestore,   // put snapshot Plan::snap back into the slot
+        kReset,     // the slot from nothing: its conv histories zeroed
+    };
+    std::vector<Slot> slots;
+    std::vector<Snap> snaps;
+    unsigned long long clock = 0;
+    Book(int n_slots, int n_snaps) : slots((size_t) n_slots), snaps((size_t) n_snaps) {}
+
+    static uint64_t sig_at(const Slot& S, size_t i) { return i < S.sig.size() ? S.sig[i] : (uint64_t) 0; }
+    // which idle slot the prompt takes (mm3's pick_slot) and what it keeps of it: the slot's whole history when the
+    // prompt extends it (a token at least left to read), else its latest snapshot at or before the shared start that
+    // leaves a token to read, else nothing
+    Plan plan(const std::vector<int>& ids, const std::vector<uint64_t>& sig) const {
+        const int N = (int) slots.size();
+        std::vector<mm3::SlotView> views((size_t) N);
+        std::vector<int> snap_of((size_t) N, -1);
+        for (int s = 0; s < N; ++s) {
+            const Slot& S = slots[(size_t) s];
+            views[(size_t) s].busy = S.busy, views[(size_t) s].size = S.hist.size(), views[(size_t) s].used = S.used;
+            if (S.busy) continue;
+            size_t L = 0;
+            while (L < S.hist.size() && L < ids.size() && S.hist[L] == ids[L] && sig_at(S, L) == sig[L]) ++L;
+            size_t from = 0;
+            if (L == S.hist.size() && L < ids.size()) {
+                from = L;
+            } else {
+                int& b = snap_of[(size_t) s];
+                for (int i = 0; i < (int) snaps.size(); ++i) {
+                    const Snap& x = snaps[(size_t) i];
+                    if (x.slot == s && x.pos >= 0 && x.pos <= (int) L && x.pos < (int) ids.size() &&
+                        (b < 0 || x.pos > snaps[(size_t) b].pos))
+                        b = i;
+                }
+                if (b >= 0) from = (size_t) snaps[(size_t) b].pos;
+            }
+            views[(size_t) s].from = from;
+        }
+        Plan p;
+        p.slot = mm3::pick_slot(views);
+        if (p.slot >= 0) p.from = views[(size_t) p.slot].from, p.snap = snap_of[(size_t) p.slot];
+        return p;
+    }
+    // the plan taken: its slot busy, its history cut to what the prompt keeps (and the slot's snapshots past it gone)
+    Act take(const Plan& p) {
+        Slot& S = slots[(size_t) p.slot];
+        S.busy = true;
+        if (p.from == S.hist.size()) return Act::kKeep;
+        if (p.from > 0 && p.snap >= 0) {
+            snaps[(size_t) p.snap].used = ++clock;
+            for (Snap& o : snaps)
+                if (o.slot == p.slot && o.pos > (int) p.from) o.slot = -1, o.pos = -1;
+            S.hist.resize(p.from);
+            if (S.sig.size() > p.from) S.sig.resize(p.from);
+            return Act::kRestore;
+        }
+        reset(p.slot);
+        return Act::kReset;
+    }
+    // a piece of a prompt read into slot s: ids [a, a + T) (and their pictures' hashes)
+    void read(int s, size_t a, const std::vector<int>& ids, const std::vector<uint64_t>& sig, size_t T) {
+        Slot& S = slots[(size_t) s];
+        S.hist.insert(S.hist.end(), ids.begin() + (std::ptrdiff_t) a, ids.begin() + (std::ptrdiff_t) (a + T));
+        S.sig.resize(a, 0);
+        S.sig.insert(S.sig.end(), sig.begin() + (std::ptrdiff_t) a, sig.begin() + (std::ptrdiff_t) (a + T));
+    }
+    void ran(int s, int tok) { slots[(size_t) s].hist.push_back(tok); }   // (a decoded token in the slot's state)
+    // an empty slot: no history, no snapshot (the engine zeroes its conv histories with it)
+    void reset(int s) {
+        slots[(size_t) s].hist.clear();
+        slots[(size_t) s].sig.clear();
+        for (Snap& o : snaps)
+            if (o.slot == s) o.slot = -1, o.pos = -1;
+    }
+    // a prompt stopped while it was read: its slot empty and free - nothing of it (nor of what the slot held before)
+    // can be reused, as the one-sequence loop resets on a prompt stopped half read
+    void cancel_read(int s) {
+        reset(s);
+        release(s);
+    }
+    // the pool's entry for a snapshot of slot s at pos: that one again, else an empty one, else the least recently used
+    int snapshot(int s, int pos) {
+        int i = -1;
+        for (int j = 0; j < (int) snaps.size(); ++j)
+            if (snaps[(size_t) j].slot == s && snaps[(size_t) j].pos == pos) i = j;
+        for (int j = 0; i < 0 && j < (int) snaps.size(); ++j)
+            if (snaps[(size_t) j].pos < 0) i = j;
+        if (i < 0) {
+            i = 0;
+            for (int j = 1; j < (int) snaps.size(); ++j)
+                if (snaps[(size_t) j].used < snaps[(size_t) i].used) i = j;
+        }
+        snaps[(size_t) i].slot = s, snaps[(size_t) i].pos = pos, snaps[(size_t) i].used = ++clock;
+        return i;
+    }
+    void release(int s) {
+        slots[(size_t) s].busy = false;
+        slots[(size_t) s].used = ++clock;
+    }
+    bool idle() const {
+        for (const Slot& s : slots)
+            if (!s.busy) return true;
+        return false;
+    }
+    int snaps_of(int s) const {
+        int n = 0;
+        for (const Snap& o : snaps) n += o.slot == s && o.pos >= 0;
+        return n;
+    }
+};
+
+// ---- a row's next token
+
+// softmax(logit / temp) over the top_p mass of the min(top_k, cand_k) largest of the (logit, token) pairs cd (ties:
+// the lower token first), one draw from rng: the one-sequence loop's pick_top, the same arithmetic and the same draw
+// (a copy: that loop stays as it was), so a seeded request draws the same tokens from the same logits in either loop
+inline int pick_top(std::vector<std::pair<float, int>>& cd, double temp, double top_p, int top_k, int cand_k,
+                    std::mt19937_64& rng) {
+    const int kk = std::min((int) cd.size(), top_k > 0 ? std::min(top_k, cand_k) : cand_k);
+    std::partial_sort(cd.begin(), cd.begin() + kk, cd.end(),
+                      [](const std::pair<float, int>& a2, const std::pair<float, int>& b2) {
+                          return a2.first > b2.first || (a2.first == b2.first && a2.second < b2.second);
+                      });
+    std::vector<double> pr((size_t) kk);
+    double z = 0;
+    for (int j = 0; j < kk; ++j) z += (pr[(size_t) j] = std::exp((cd[(size_t) j].first - cd[0].first) / temp));
+    double acc = 0;
+    int keep = kk;
+    for (int j = 0; j < kk; ++j) {
+        acc += pr[(size_t) j] / z;
+        if (acc >= top_p) {
+            keep = j + 1;
+            break;
+        }
+    }
+    double zk = 0;
+    for (int j = 0; j < keep; ++j) zk += pr[(size_t) j];
+    double u = std::uniform_real_distribution<double>(0, zk)(rng);
+    for (int j = 0; j < keep; ++j) {
+        u -= pr[(size_t) j];
+        if (u <= 0) return cd[(size_t) j].second;
+    }
+    return cd[(size_t) keep - 1].second;
+}
+
+// a decode step's row -> its next token: greedy, the raw logits' argmax the step gave (before the softcap - every
+// rows step gives it, so a greedy row's rule does not change when a sampled row runs beside it: the capped logits can
+// tie where the raw ones do not); sampled, a draw over its candidates (or its row's logits as candidates)
+inline int pick_next(double temp, int raw_argmax, std::vector<std::pair<float, int>>& cd, double top_p, int top_k,
+                     int cand_k, std::mt19937_64& rng) {
+    if (temp <= 0) return raw_argmax;
+    return pick_top(cd, temp, top_p, top_k, cand_k, rng);
+}
+
+// ---- the loop
+
+struct LoopConfig {
+    int n_slots = 2, n_snaps = 8, vocab = 0, chunk = 2048, piece = 2048, cand_k = 1000;
+    long long ctx = 0;
+    std::vector<int> eos;   // the tokens a request ends at
+};
+struct StepRow {   // a decode step's row: the token run, its slot and position, whether its request samples
+    int tok = -1, slot = 0, pos = 0;
+    bool sampled = false;
+};
+struct StepOut {   // ... and what the step gave it: a greedy row its raw-logit argmax, a sampled row its candidates
+    int argmax = -1;
+    std::vector<std::pair<float, int>> cands;
+};
+
+// The multi-request loop (serve_multi), over a model side B - the engine's GPU work (ik2_main.cu), or a stand-in
+// (tests/ik2_serve_fake.cpp):
+//   void zero(int slot)                        the slot's conv histories zeroed (an empty slot's state)
+//   void snap(int i, int slot, int pos, bool save)   pool entry i saved from the slot (its state after pos tokens) /
+//                                              put back into it
+//   bool pictures(const Req&, std::vector<uint64_t>& sig, std::string& err)   a GENI's pictures loaded (sig: a
+//                                              picture row's hash at its position); pictures_done() after its read
+//   void read(int slot, const std::vector<int>& ids, size_t a, int T, bool last, std::vector<float>& logits)
+//                                              ids [a, a + T) through the prompt path on the slot (last: the
+//                                              softcapped logits of its last token, [vocab])
+//   void step(const std::vector<StepRow>&, std::vector<StepOut>&)   one decode step, a row each
+//   bool signal()                              a SIGUSR1 since the last look (taken as a STOP)
+//   double seconds(); void print(const std::string& line); void flush(); void log(const std::string&);
+//   void fatal(const std::string&)             (does not return)
+// The lines are taken in order (pump) after every blocking call and before anything that depends on them: after each
+// prompt piece's read (and the prompt-end snapshot) before that request writes anything (PP, its first token, a DONE),
+// before and after each decode step (before its tokens are written), before each admission, and while idle.  So every
+// line that came before a request starts, writes a token or completes is honoured first - a STOP among them included.
+// Returns true at QUIT, false at the input's end.
+template <class B>
+bool serve_loop(B& be, Lines& in, const LoopConfig& cf) {
+    Book book(cf.n_slots, cf.n_snaps);
+    Control ctl;
+    ctl.n_vocab = cf.vocab, ctl.ctx = cf.ctx;
+    bool wrote = false;
+    ctl.out = [&](const std::string& l) {
+        be.print(l);
+        wrote = true;
+    };
+    struct Gen {
+        Req r;                      // its request: rid, sampling, prompt
+        int slot = 0, produced = 0, cached = 0;
+        std::mt19937_64 rng;
+        int tok = -1;               // the next token: written (T) at the next show, then run at the next feed
+        bool shown = false, done = false;
+        bool cancel = false;        // (a STOP for it: Control sets it)
+        const char* finish = "length";
+        double t0 = 0, t1 = 0;      // the request's start and its prompt's end (seconds)
+    };
+    std::vector<std::unique_ptr<Gen>> run;
+    std::mt19937_64 seeder(1234);   // (a request without seed=: its rng's seed drawn from here)
+    char buf[512];
+    for (int s = 0; s < cf.n_slots; ++s) be.zero(s);
+    // every line come so far, in order; a SIGUSR1 then as a STOP; the stopped queued requests out (their DONE)
+    auto pump = [&]() {
+        Line l;
+        while (!ctl.quit && in.try_next(l)) ctl.line(l);
+        if (be.signal()) ctl.stop_all();
+        ctl.retire();
+        if (wrote) {
+            be.flush();
+            wrote = false;
+        }
+    };
+    auto is_stop = [&](int t) { return std::find(cf.eos.begin(), cf.eos.end(), t) != cf.eos.end(); };
+    // a request's end: its DONE line (the one-sequence loop's fields after the rid; no suffix drafts), its slot free
+    auto finish = [&](Gen& g) {
+        const double t2 = be.seconds();
+        std::snprintf(buf, sizeof buf, "DONE %d %d %zu %.1f %.1f %s 0 0 %d", g.r.rid, g.produced, g.r.ids.size(),
+                      (g.t1 - g.t0) * 1e3, (t2 - g.t1) * 1e3, g.finish, g.cached);
+        be.print(buf);
+        std::snprintf(buf, sizeof buf,
+                      "maya-ik2 serve: request %d (slot %d): prompt %zu tokens = %d reused + %zu read in %.0f ms, %d "
+                      "generated in %.0f ms (%.2f tok/s, %zu running) - %s",
+                      g.r.rid, g.slot, g.r.ids.size(), g.cached, g.r.ids.size() - (size_t) g.cached,
+                      (g.t1 - g.t0) * 1e3, g.produced, (t2 - g.t1) * 1e3,
+                      t2 > g.t1 ? g.produced / (t2 - g.t1) : 0.0, run.size(), g.finish);
+        be.log(buf);
+        book.release(g.slot);
+        ctl.ended(g.r.rid);
+        g.done = true;
+    };
+    // every token drawn and not written yet: written (T lines, one flush); a request that ends there finishes
+    auto show = [&]() {
+        bool out = false;
+        for (auto& gp : run) {
+            Gen& g = *gp;
+            if (g.done || g.shown) continue;
+            out = true;
+            if (g.cancel) {
+                g.finish = "cancel";
+                finish(g);
+                continue;
+            }
+            if (g.produced >= g.r.max_new) {   // (max_new 0: no token at all)
+                finish(g);
+                continue;
+            }
+            std::snprintf(buf, sizeof buf, "T %d %d", g.r.rid, g.tok);
+            be.print(buf);
+            ++g.produced;
+            if (is_stop(g.tok)) {
+                g.finish = "stop";
+                finish(g);
+            } else if (g.produced >= g.r.max_new) {   // (the last token is written, not run)
+                g.finish = "length";
+                finish(g);
+            } else {
+                g.shown = true;
+            }
+        }
+        if (out) be.flush();
+    };
+    auto sweep = [&]() {
+        run.erase(std::remove_if(run.begin(), run.end(), [](const std::unique_ptr<Gen>& p) { return p->done; }),
+                  run.end());
+    };
+    // a decode step: the written token of every running request read, a row each, the next ones drawn
+    std::vector<StepRow> rows_in;
+    std::vector<StepOut> rows_out;
+    auto feed = [&]() {
+        std::vector<Gen*> rows;
+        for (auto& gp : run)
+            if (!gp->done && gp->shown) rows.push_back(gp.get());
+        if (rows.empty()) return;
+        if ((int) rows.size() > cf.n_slots) be.fatal("--serve --parallel: more running requests than slots");
+        rows_in.assign(rows.size(), StepRow{});
+        for (size_t r = 0; r < rows.size(); ++r)
+            rows_in[r] = {rows[r]->tok, rows[r]->slot, (int) book.slots[(size_t) rows[r]->slot].hist.size(),
+                          rows[r]->r.temp > 0};
+        be.step(rows_in, rows_out);
+        for (size_t r = 0; r < rows.size(); ++r) {
+            Gen& g = *rows[r];
+            book.ran(g.slot, rows_in[r].tok);
+            g.tok = pick_next(g.r.temp, rows_out[r].argmax, rows_out[r].cands, g.r.top_p, g.r.top_k, cf.cand_k, g.rng);
+            g.shown = false;
+        }
+    };
+    // (every input line that came before a token is written, or a request completes, is taken first: a pump after
+    //  each blocking call - a decode step here, a prompt's piece and its snapshot in admit - and before each
+    //  admission, so a STOP that came while the GPU worked is honoured before the next T or DONE)
+    auto step = [&]() {
+        pump();   // (the STOPs that came before this step)
+        show();   // (a request admitted since the last step: its first token)
+        feed();
+        pump();   // (... and those that came during it: before its tokens are written)
+        show();
+        sweep();
+    };
+    // a request from the queue: its slot, its prompt read, its first token drawn - then it runs with the others
+    auto admit = [&](Req r) {
+        if (r.cancel) {   // (stopped after the last pump: its DONE now)
+            ctl.done_cancel(r.rid, r.ids.size());
+            be.flush();
+            return;
+        }
+        std::vector<uint64_t> sig(r.ids.size(), 0);
+        std::string err;
+        if (!be.pictures(r, sig, err)) {
+            be.print("ERR " + std::to_string(r.rid) + " " + err);
+            ctl.done_cancel(r.rid, r.ids.size());
+            be.flush();
+            return;
+        }
+        const Book::Plan pl = book.plan(r.ids, sig);
+        if (pl.slot < 0) {   // (every slot busy: back to the queue's front - the loop admits only with one idle)
+            be.pictures_done();
+            ctl.waiting.push_front(std::move(r));
+            return;
+        }
+        auto gp = std::make_unique<Gen>();
+        Gen& g = *gp;
+        g.r = std::move(r);
+        ctl.started(g.r.rid, &g.cancel);   // (a STOP for it from here on: its flag)
+        const Book::Act act = book.take(pl);
+        if (act == Book::Act::kRestore) be.snap(pl.snap, pl.slot, (int) pl.from, false);   // (back to the snapshot)
+        else if (act == Book::Act::kReset) be.zero(pl.slot);                              // (the slot from nothing)
+        g.slot = pl.slot, g.cached = (int) pl.from;
+        g.t0 = be.seconds();
+        const std::vector<int>& ids = g.r.ids;
+        std::vector<float> last;
+        bool cancel = false;
+        for (size_t a = pl.from; a < ids.size();) {
+            const int T = (int) std::min<size_t>((size_t) (run.empty() ? cf.chunk : cf.piece), ids.size() - a);
+            const bool last_c = a + (size_t) T == ids.size();
+            be.read(g.slot, ids, a, T, last_c, last);
+            book.read(g.slot, a, ids, sig, (size_t) T);
+            a += (size_t) T;
+            if (last_c) {   // the prompt's end: its snapshot, its first token drawn (written below, after the pump)
+                if ((int) last.size() < cf.vocab) be.fatal("--serve --parallel: no logits after a prompt");
+                const int si = book.snapshot(g.slot, (int) ids.size());
+                be.snap(si, g.slot, (int) ids.size(), true);
+                g.t1 = be.seconds();
+                // (a request's own seed alone, as with one sequence: the same seed, the same answer)
+                g.rng.seed(g.r.seed >= 0 ? (uint64_t) g.r.seed : seeder());
+                if (g.r.temp <= 0) {   // (as the one-sequence loop picks it: the prompt's softcapped logits)
+                    g.tok = (int) (std::max_element(last.begin(), last.begin() + cf.vocab) - last.begin());
+                } else {
+                    std::vector<std::pair<float, int>> cd((size_t) cf.vocab);
+                    for (int v = 0; v < cf.vocab; ++v) cd[(size_t) v] = {last[(size_t) v], v};
+                    g.tok = pick_top(cd, g.r.temp, g.r.top_p, g.r.top_k, cf.cand_k, g.rng);
+                }
+            }
+            // every line that came while the piece was read (and its snapshot taken) - a STOP for this request, or
+            // for a waiting one, among them - before anything of this request is written: its PP, its first token
+            pump();
+            if (g.cancel) {
+                cancel = true;
+                break;
+            }
+            const double ms = (be.seconds() - g.t0) * 1e3;   // (read, total, ms, tok/s, reused)
+            std::snprintf(buf, sizeof buf, "PP %d %zu %zu %.0f %.1f %d", g.r.rid, a, ids.size(), ms,
+                          (double) (a - pl.from) / std::max(1e-3, ms / 1e3), g.cached);
+            be.print(buf);
+            be.flush();
+            if (last_c) break;
+            if (!run.empty()) step();   // (the running requests' next token)
+            if (g.cancel) {
+                cancel = true;
+                break;
+            }
+        }
+        be.pictures_done();
+        // a prompt stopped before its first token - between its pieces, or during its last - leaves its slot empty:
+        // nothing of it, or before it, to be reused (its prompt-end snapshot too, if taken)
+        if (cancel) {
+            book.cancel_read(g.slot);
+            be.zero(g.slot);
+            std::snprintf(buf, sizeof buf, "DONE %d 0 %zu %.1f 0 cancel 0 0 %d", g.r.rid, ids.size(),
+                          (be.seconds() - g.t0) * 1e3, g.cached);
+            be.print(buf);
+            be.flush();
+            ctl.ended(g.r.rid);
+            return;
+        }
+        g.shown = false;
+        run.push_back(std::move(gp));
+        show();   // (its first token out now, not after the next prompt's first piece)
+        sweep();
+    };
+    while (!ctl.quit) {
+        if (run.empty() && ctl.waiting.empty()) {   // (idle: wait for a line)
+            Line l;
+            if (!in.next(l)) break;
+            ctl.line(l);
+        }
+        for (;;) {   // (a pump before each admission: the lines that came during the last one first)
+            pump();
+            if (ctl.quit || ctl.waiting.empty() || !book.idle()) break;
+            Req r;
+            ctl.take(r);
+            admit(std::move(r));
+        }
+        if (ctl.quit) break;
+        if (!run.empty()) step();
+        else if (ctl.waiting.empty() && in.ended()) break;
+    }
+    return ctl.quit;
+}
+
+}  // namespace ik2::serve
