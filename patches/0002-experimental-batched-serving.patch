+// Every conv history of the rows' slots moves on a token and their K / V get the rows' positions.
+void fast_rows(Model& M, const int* tok, const int* slot, const int* pos, int R, OutMode out_mode,
+               std::vector<float>& logits_out, std::vector<int>* argmax_out) {
+    const Config& c = M.c;
+    if (!g_rows.ready) die("fast_rows: the rows path is not set up (--parallel 2 or more)");
+    if (out_mode == OutMode::kNone) die("fast_rows: a step without its outputs");
+    rows_validate(M, slot, pos, R);
+    Work& W = dev_work(0);
+    const size_t rb = (size_t) c.C / k::block_values(M.embd_type) * k::block_bytes(M.embd_type);
+    for (int t = 0; t < R; ++t) {
