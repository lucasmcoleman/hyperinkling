+// ---- --serve with --parallel N > 1: several requests at once (serve_multi, ported from src/mm3/mm3_main.cpp's: the
+// loop and its bookkeeping in ik2_serve.hpp, sv::serve_loop; its model side - the GPU work - here, IkServe)
+namespace sv = ik2::serve;
+
+// sv::serve_loop's model side on the engine: the slots' state (Model::slots), the prompt path, a decode step through
+// the token path (a lone row) or the rows path, the snapshots' bytes
+struct IkServe {
+    Model& M;
+    int ctx = 0, image_token = 0, V = 0, C = 0;
+    size_t KD = 0, kv_elem_b = 1;
+    bool use_cand = true, rows1 = false;
+    // a snapshot's bytes, by the book's pool index: the conv histories (pinned) and a sliding visit's last window of
+    // K / V when its ring wraps (host memory)
+    struct SnapBytes {
+        float* h = nullptr;
+        std::vector<std::vector<uint8_t>> kv_k, kv_v;
+    };
+    std::vector<SnapBytes> pool;
+    std::vector<float> row_h;
+    double t_exp = 0;
+
+    IkServe(Model& m, int ctx_, int image_token_, int n_snaps, bool use_cand_, bool rows1_)
+        : M(m), ctx(ctx_), image_token(image_token_), V(m.c.n_vocab), C(m.c.C), KD((size_t) m.c.KV * m.c.D),
+          kv_elem_b(g_kv_fp8 ? 1 : 2), use_cand(use_cand_), rows1(rows1_), pool((size_t) n_snaps) {
+        const size_t per_v = 3 * (2 * KD + 2 * (size_t) C);   // floats a visit's conv histories take
+        for (SnapBytes& sb : pool) {
+            CU(cudaHostAlloc(&sb.h, (size_t) M.c.n_visit * per_v * 4, cudaHostAllocPortable));
+            sb.kv_k.resize(M.V.size());
+            sb.kv_v.resize(M.V.size());
+            for (size_t v = 0; v < M.V.size(); ++v) {
+                const Visit& Vi = M.slots[0][v];
+                if (M.L[Vi.l].sliding && Vi.kv_cap < ctx) {
+                    sb.kv_k[v].resize((size_t) M.c.window * KD * kv_elem_b);
+                    sb.kv_v[v].resize((size_t) M.c.window * KD * kv_elem_b);
+                }
+            }
+        }
+    }
+    // a slot's conv histories zeroed: an empty slot's state (its K / V needs nothing: positions rewrite cleanly)
+    void zero(int s) {
+        for (const Visit& Vi : M.slots[(size_t) s]) {
+            CU(cudaMemsetAsync(Vi.h_k, 0, 3 * KD * 4, g_s));
+            CU(cudaMemsetAsync(Vi.h_v, 0, 3 * KD * 4, g_s));
+            CU(cudaMemsetAsync(Vi.h_attn, 0, 3 * (size_t) C * 4, g_s));
+            CU(cudaMemsetAsync(Vi.h_mlp, 0, 3 * (size_t) C * 4, g_s));
+        }
+    }
+    // pool entry i saved from slot s (its state after pos tokens) or put back into it: the one-sequence loop's
+    // snap_copy on the slot's own buffers
+    void snap(int i, int s, int pos, bool save) {
+        SnapBytes& sb = pool[(size_t) i];
+        const cudaMemcpyKind dir = save ? cudaMemcpyDeviceToHost : cudaMemcpyHostToDevice;
+        const size_t row_b = KD * kv_elem_b;
+        const size_t cc[4] = {KD, KD, (size_t) C, (size_t) C};
+        float* hb = sb.h;
+        for (size_t v = 0; v < M.V.size(); ++v) {
+            const Visit& Vi = M.slots[(size_t) s][v];
+            float* hs[4] = {Vi.h_k, Vi.h_v, Vi.h_attn, Vi.h_mlp};
+            for (int j = 0; j < 4; ++j) {
+                CU(cudaMemcpyAsync(save ? hb : hs[j], save ? hs[j] : hb, 3 * cc[j] * 4, dir, g_s));
+                hb += 3 * cc[j];
+            }
+            if (pos > 0 && M.L[Vi.l].sliding && Vi.kv_cap < ctx) {
+                const int w = std::min(pos, M.c.window);
+                const int k_start = pos - w;
+                const int s0 = k_start % Vi.kv_cap;
+                const int n1 = std::min(w, Vi.kv_cap - s0);
+                const int n2 = w - n1;
+                uint8_t* dk = g_kv_fp8 ? Vi.kc8 : (uint8_t*) Vi.kc;
+                uint8_t* dv = g_kv_fp8 ? Vi.vc8 : (uint8_t*) Vi.vc;
+                uint8_t* hk = sb.kv_k[v].data();
+                uint8_t* hv = sb.kv_v[v].data();
+                CU(cudaMemcpyAsync(save ? hk : dk + (size_t) s0 * row_b, save ? dk + (size_t) s0 * row_b : hk,
+                                   (size_t) n1 * row_b, dir, g_s));
+                CU(cudaMemcpyAsync(save ? hv : dv + (size_t) s0 * row_b, save ? dv + (size_t) s0 * row_b : hv,
+                                   (size_t) n1 * row_b, dir, g_s));
+                if (n2 > 0) {
+                    CU(cudaMemcpyAsync(save ? hk + (size_t) n1 * row_b : dk, save ? dk : hk + (size_t) n1 * row_b,
+                                       (size_t) n2 * row_b, dir, g_s));
+                    CU(cudaMemcpyAsync(save ? hv + (size_t) n1 * row_b : dv, save ? dv : hv + (size_t) n1 * row_b,
+                                       (size_t) n2 * row_b, dir, g_s));
+                }
+            }
+        }
+        CU(cudaStreamSynchronize(g_s));
+    }
+    // a GENI's pictures into g_img while its prompt is read (a GEN: none)
+    bool pictures(const sv::Req& r, std::vector<uint64_t>& sig, std::string& err) {
+        g_img.clear();
+        if (r.pictures.empty()) return true;
+        Pictures pics;
+        err = load_pictures(r.pictures, r.ids, image_token, C, pics, sig);
+        if (!err.empty()) return false;
+        g_img = std::move(pics);
+        return true;
+    }
+    void pictures_done() { g_img.clear(); }
+    // a prompt's piece on slot s: bind_slot, forward() - the prompt path, as with one sequence
+    void read(int s, const std::vector<int>& ids, size_t a, int T, bool last, std::vector<float>& logits) {
+        bind_slot(M, s);   // (a decode step between two pieces bound another slot)
+        std::vector<float> lo;
+        forward(M, ids.data() + a, T, (int) a, false, last ? OutMode::kLogits : OutMode::kNone, std::string(), lo,
+                nullptr, t_exp);
+        if (last) logits = std::move(lo);
+    }
+    // one decode step: two or more rows through the rows path, a lone row through its slot's token path
+    // (IK2_SERVE_ROWS1=1: the rows path too).  Every row greedy: kArgmax; else kCand (IK2_CAND=0: kLogits) - the rows
+    // path gives every row's raw argmax beside them, which a greedy row takes
+    void step(const std::vector<sv::StepRow>& rows, std::vector<sv::StepOut>& out) {
+        const int R = (int) rows.size();
+        if (R < 1 || R > (int) M.slots.size()) die("--serve --parallel: a step of " + std::to_string(R) + " rows");
+        int tk[kParMax], sl[kParMax], ps[kParMax];
+        bool sampled = false;
+        for (int r = 0; r < R; ++r) {
+            tk[r] = rows[(size_t) r].tok, sl[r] = rows[(size_t) r].slot, ps[r] = rows[(size_t) r].pos;
+            sampled = sampled || rows[(size_t) r].sampled;
+        }
+        const OutMode om = !sampled ? OutMode::kArgmax : use_cand ? OutMode::kCand : OutMode::kLogits;
+        const bool tok_path = R == 1 && !rows1;
+        std::vector<float> lo;
+        std::vector<int> am;
+        if (tok_path) decode_rows(M, tk, sl, ps, 1, om, lo, &am);   // (one row: greedy kArgmax, sampled its candidates)
+        else fast_rows(M, tk, sl, ps, R, om, lo, &am);   // (rows_validate: valid, distinct slots and positions)
+        out.assign((size_t) R, sv::StepOut{});
+        for (int r = 0; r < R; ++r) {
+            sv::StepOut& o = out[(size_t) r];
+            if (!rows[(size_t) r].sampled) {
+                o.argmax = am[(size_t) r];
+                continue;
+            }
+            bool have = false;
+            if (om == OutMode::kCand) {
+                if (tok_path) {
+                    have = g_cand.n >= 0;
+                    if (have) {
+                        o.cands.resize((size_t) g_cand.n);
+                        for (int i = 0; i < g_cand.n; ++i) o.cands[(size_t) i] = {g_cand.val[i], g_cand.idx[i]};
+                    }
+                } else {
+                    have = block_cands(M, r, o.cands);
+                }
+            }
+            if (!have) {   // (kLogits, or more candidates than kept: the row's logits, softcapped)
+                const float* rp = lo.data() + (size_t) (om == OutMode::kLogits ? r : 0) * V;
+                if (om == OutMode::kCand && !tok_path) {
+                    row_h.resize((size_t) V);
+                    CU(cudaMemcpy(row_h.data(), dev_work(0).logits + (size_t) r * M.c.n_rows, (size_t) V * 4,
+                                  cudaMemcpyDeviceToHost));
+                    rp = row_h.data();
+                }
+                o.cands.resize((size_t) V);
+                for (int v = 0; v < V; ++v) o.cands[(size_t) v] = {rp[v], v};
+            }
+        }
+    }
+    bool signal() {   // (SIGUSR1: taken as a STOP)
+        if (!g_cancel) return false;
+        g_cancel = 0;
+        return true;
+    }
+    double seconds() { return now(); }
+    void print(const std::string& l) {
+        std::fwrite(l.data(), 1, l.size(), stdout);
+        std::fputc('\n', stdout);
+    }
+    void flush() { std::fflush(stdout); }
+    void log(const std::string& l) { std::fprintf(stderr, "%s\n", l.c_str()); }
+    [[noreturn]] void fatal(const std::string& m) { die(m); }
+};
+
+// --serve with --parallel N (N > 1): up to N requests at once, through serve/server.py's multi protocol (as maya-mm3's
+// and the GLM engine's).  READY <ctx> stop multi=<N>; every GEN / GENI carries rid=<id>, and every line a request
+// causes carries it after its keyword: PP <rid> ..., T <rid> <id>, DONE <rid> <the one-sequence loop's DONE fields>,
+// ERR <rid> ...; STOP <rid> ends that request, STOP alone every request whose line came before it.
+//   * stdin's lines are taken in the order they came at every boundary of the loop - before each decode step,
+//     between a prompt's pieces, while idle.  A GEN is checked first (sv::parse_gen: its rid, max_new, token ids, the
+//     context - else ERR <rid> and its DONE, the running requests going on) and queued.  A STOP stops whatever is
+//     live of what came before it, and a stopped queued request has its DONE at once, slot or no slot.
+//   * A request takes a slot (Model::slots: its own K / V and conv histories) as sv::Book plans it: the idle one
+//     whose kept tokens its prompt reuses the most - its whole history when the prompt extends it, else up to one of
+//     the snapshots - with mm3's rule for a short shared start (pick_slot), else one that drops nothing (empty), else
+//     the least recently used.
+//   * Its prompt is read on that slot (bind_slot, forward() - the prompt path, as with one sequence) in --chunk pieces
+//     (IK2_SERVE_PIECE=n: pieces of n tokens while other requests run), one decode step of the running requests
+//     between two pieces.  A prompt stopped between its pieces leaves its slot empty - no history, no snapshot, its
+//     conv histories zeroed - as the one-sequence loop resets on a prompt stopped half read.
+//   * Decode: one step for every running request, a token each - two or more rows through the rows path (fast_rows),
+//     a request alone through its slot's token path (decode_rows); IK2_SERVE_ROWS1=1 (for checks): a lone row
+//     through the rows path too, so that a request's tokens are the same bits whatever runs beside it.  A greedy row
+//     takes the raw logits' argmax in every step (fast_rows gives it beside a sampled row's candidates); a sampled row
+//     draws with its own rng (seed=, else one drawn for it), temperature, top_p and top_k.  A step's T lines go out
+//     together, one flush.
+//   * Snapshots: one pool of 8 for all the slots (each a slot's conv histories in pinned host memory and its sliding
+//     layers' last window of K / V in host memory, at a prompt's end), the least recently used replaced; a snapshot
+//     restores only the slot it was taken on (that slot's full layers hold the positions before it).
+//   * No drafting (--draft is refused with --parallel > 1), no suffix verification.
+int serve_multi(Model& M, const std::vector<int>& eos, int ctx, int chunk, int image_token, int n_gpu) {
+    const int N = (int) M.slots.size();
+    if (!g_rows.ready || N < 2 || g_rows.n_slots != N) die("--serve --parallel: the rows path is not set up");
+    const bool use_cand = !(getenv("IK2_CAND") && !std::atoi(getenv("IK2_CAND")));
+    const bool rows1 = getenv("IK2_SERVE_ROWS1") && std::atoi(getenv("IK2_SERVE_ROWS1"));
+    sv::LoopConfig cf;
+    cf.n_slots = N, cf.n_snaps = 8, cf.vocab = M.c.n_vocab, cf.ctx = ctx, cf.chunk = chunk, cf.cand_k = kCandK;
+    cf.piece = getenv("IK2_SERVE_PIECE") ? std::clamp(std::atoi(getenv("IK2_SERVE_PIECE")), 1, chunk) : chunk;
+    cf.eos = eos;
