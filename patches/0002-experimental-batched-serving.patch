+// ---- 3. a greedy row's rule does not change beside a sampled row
+
+static void greedy_row_takes_the_raw_argmax_on_a_capped_tie() {
+    const int f0 = g_fail;
+    const float cap = 30.0f;
+    std::vector<float> raw(64, -1.0f);
+    raw[5] = 360.0f, raw[9] = 390.0f;   // (raw winner: 9)
+    std::vector<float> capped(raw.size());
+    for (size_t i = 0; i < raw.size(); ++i) capped[i] = cap * tanhf(raw[i] / cap);   // (the kernel's softcap)
+    CHECK(capped[5] == capped[9]);   // float32: both 30 - a tie the raw logits do not have
+    int raw_arg = 0;
+    for (int i = 1; i < (int) raw.size(); ++i)
+        if (raw[(size_t) i] > raw[(size_t) raw_arg]) raw_arg = i;
+    CHECK(raw_arg == 9);
+    // the capped-candidate rule for a greedy row in a mixed step: the largest capped candidate, the lower id on a tie
+    std::vector<std::pair<float, int>> cd;
+    for (int i = 0; i < (int) capped.size(); ++i) cd.push_back({capped[(size_t) i], i});
+    int old_rule = 0;
+    for (int i = 1; i < (int) cd.size(); ++i)
+        if (cd[(size_t) i].first > cd[(size_t) old_rule].first ||
+            (cd[(size_t) i].first == cd[(size_t) old_rule].first && cd[(size_t) i].second < cd[(size_t) old_rule].second))
+            old_rule = i;
+    CHECK(old_rule == 5);   // (what a sampled neighbour used to make a greedy row pick)
+    std::mt19937_64 rng(1);
+    CHECK(sv::pick_next(0.0, raw_arg, cd, 1.0, 0, 1000, rng) == 9);   // the fix: the raw argmax, as kArgmax gives
+    CHECK(sv::pick_next(-1.0, raw_arg, cd, 1.0, 0, 1000, rng) == 9);
+    // a sampled row still draws over its candidates: top_k 1 takes the largest capped one (ties: the lower id)
+    std::mt19937_64 r2(7);
+    CHECK(sv::pick_next(0.7, -1, cd, 1.0, 1, 1000, r2) == 5);
+    ok("greedy row beside a sampled one: raw argmax 9 on a softcap tie (capped 30 = 30; the old rule gave 5)", f0);
+}
