+// Every graph the slots' decode uses, captured (and uploaded) at load, so that no capture runs mid-request - where the
+// VRAM it needs may be gone: each slot's token graphs (4 OutModes) and the rows path's for 1 .. N rows (kArgmax,
+// kLogits, kCand).
+void rows_capture(Model& M) {
+    const int N = g_rows.n_slots;
+    if (!g_graph) {
+        std::printf("rows path: %d slots, their launches one by one (IK2_GRAPH=0)\n", N);
+        return;
+    }
+    Work& W = dev_work(0);
+    k::enable_grouped_tensor_products(allow_short_batch_products());   // (as forward() sets it before a token)
+    CU(cudaDeviceSynchronize());
+    size_t f0 = 0, f1 = 0, tot = 0;
+    CU(cudaMemGetInfo(&f0, &tot));
+    const double t0 = now();
+    const uint64_t n0 = g_n_capture;
+    for (int s = 0; s < N; ++s) {
+        bind_slot(M, s);
+        for (int m = 0; m < 4; ++m) capture_graph(g_sgraph[s][m], [&] { fast_token_launches(M, W, (OutMode) m); });
+    }
+    bind_slot(M, 0);
