+    p = bk.plan(D, sD);
+    CHECK(p.slot == 0 && p.from == A.size() && p.snap >= 0);
+    CHECK(bk.take(p) == sv::Book::Act::kRestore);
+    bk.read(0, A.size(), D, sD, 2048);
+    bk.cancel_read(0);
+    CHECK(bk.slots[0].hist.empty() && bk.slots[0].sig.empty() && !bk.slots[0].busy);
+    CHECK(bk.snaps_of(0) == 0);   // (A's snapshot too: the slot is empty, as the scope asks)
+    // the refill: the same prompt again - nothing reused (zero reused tokens), the same plan as on a fresh slot
+    const sv::Book::Plan pr = bk.plan(D, sD);
+    CHECK(pr.slot == 0 && pr.from == 0 && pr.snap < 0);
+    sv::Book fresh(2, 8);
+    sv::Book::Plan pf0 = fresh.plan(other, sO);
+    pf0.slot = 1;   // (the same occupancy: slot 1 busy)
+    fresh.take(pf0);
+    const sv::Book::Plan pf = fresh.plan(D, sD);
+    CHECK(pf.slot == pr.slot && pf.from == pr.from && pf.snap == pr.snap);
+    CHECK(bk.take(pr) == sv::Book::Act::kKeep);   // (empty: the engine zeroed its conv histories at the stop)
+    // a prompt made of what the stopped read had read, and more: nothing of it either
+    std::vector<int> E(D.begin(), D.begin() + (std::ptrdiff_t) (A.size() + 2048));
+    E.push_back(5);
+    bk.read(0, 0, D, sD, 10);   // (refill under way; then it ends)
+    bk.cancel_read(0);
+    const sv::Book::Plan pe = bk.plan(E, std::vector<uint64_t>(E.size(), 0));
+    CHECK(pe.slot == 0 && pe.from == 0);
+    // recycling the slot without clearing it (the slot only given back, its history kept) would have reused 2648 tokens
+    sv::Book old(2, 8);
+    sv::Book::Plan q = old.plan(other, sO);
+    q.slot = 1;
+    old.take(q);
+    q = old.plan(D, sD);
+    old.take(q);
+    old.read(q.slot, 0, D, sD, 2048);
+    old.release(q.slot);
+    CHECK(old.plan(D, sD).from == 2048);   // (what this test would catch)
+    ok("a prompt stopped after a piece: slot 0 empty, no snapshot; its refill reuses 0 tokens (the old way: 2048)", f0);
+}
+
+static void book_plans_and_snapshots() {
+    const int f0 = g_fail;
+    const std::vector<int> A = seq_ids(1000, 700);
+    sv::Book bk(3, 8);
+    const auto z = [](const std::vector<int>& v) { return std::vector<uint64_t>(v.size(), 0); };
+    sv::Book::Plan p = bk.plan(A, z(A));
+    bk.take(p);
+    bk.read(p.slot, 0, A, z(A), A.size());
+    bk.snapshot(p.slot, (int) A.size());
+    bk.release(p.slot);
+    // extends the history: kept whole, nothing to do
+    std::vector<int> B = A;
+    B.push_back(5);
+    p = bk.plan(B, z(B));
+    CHECK(p.slot == 0 && p.from == A.size());
+    CHECK(bk.take(p) == sv::Book::Act::kKeep);
+    bk.read(0, A.size(), B, z(B), 1);
+    bk.ran(0, 6);
+    bk.release(0);
+    // parts from it after A: back to A's snapshot; the slot's later snapshots go
+    bk.snapshot(0, (int) B.size());
+    std::vector<int> C = A;
+    C.push_back(77);
+    p = bk.plan(C, z(C));
+    CHECK(p.slot == 0 && p.from == A.size() && p.snap >= 0 && bk.snaps[(size_t) p.snap].pos == (int) A.size());
+    CHECK(bk.take(p) == sv::Book::Act::kRestore);
+    CHECK(bk.slots[0].hist.size() == A.size() && bk.snaps_of(0) == 1);
+    bk.release(0);
+    // a short shared start (under 512 tokens, under half of what it drops) does not take that slot: an empty one
+    std::vector<int> S(A.begin(), A.begin() + 100);
+    S.push_back(99999);
+    p = bk.plan(S, z(S));
+    CHECK(p.slot == 1 && p.from == 0);
+    // a picture row at a position: the same token with another hash is not shared
+    std::vector<uint64_t> sigA = z(A);
+    sigA[3] = 0xabc;
+    p = bk.plan(B, sigA);
+    CHECK(p.from < 4 || p.slot != 0);
+    // the pool: an entry again for the same slot and position, else an empty one, else the least recently used
+    sv::Book bp(2, 3);
+    const int i0 = bp.snapshot(0, 10), i1 = bp.snapshot(0, 20), i2 = bp.snapshot(1, 30);
+    CHECK(i0 != i1 && i1 != i2 && i0 != i2);
+    CHECK(bp.snapshot(0, 20) == i1);
+    CHECK(bp.snapshot(1, 40) == i0);   // (0@10: the least recently used)
+    ok("Book: extend, restore (later snapshots dropped), short shared start, picture hash, snapshot pool", f0);
+}
