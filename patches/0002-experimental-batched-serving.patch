+    CHECK(h.ctl.take(d) && d.rid == 4 && !d.cancel);
+    CHECK(h.count_prefix("DONE 3 ") == 1 && h.count_prefix("DONE 4 ") == 0);
+    ok("STOP: every earlier live (1, 2) and queued (3: one zero-token DONE) request, no later one (4)", f0);
