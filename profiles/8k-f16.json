{
  "exe": "/opt/maya/bin/maya-ik2",
  "cwd": "/opt/maya/source",
  "args": [
    "--model",
    "/models/Inkling-2-Mini-UD-Q4_K_M.gguf",
    "--max-context",
    "8192"
